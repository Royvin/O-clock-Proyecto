@{
    ViewData["Title"] = "Configuración de Feriados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .main-layout {
        display: flex;
        min-height: 600px;
    }

        .sidebar {
        width: 300px;
        flex-shrink: 0;
        background: #FFFFFF;
        padding: 30px 20px;
        border-right: 1px solid #E0E0E0;
        box-shadow: 2px 0 10px rgba(0,0,0,0.03);
        position: sticky;
        top: 70px;
        align-self: flex-start;
        max-height: calc(100vh - 70px);
        overflow-y: auto;
    }

    .menu-item {
        padding: 0;
        margin: 4px 0;
        border-radius: 10px;
        transition: all 0.3s;
        position: relative;
    }

    .menu-link {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px 16px;
        color: #455A64;
        text-decoration: none;
        font-weight: 500;
        border-radius: 10px;
        transition: all 0.3s;
        position: relative;
    }

        .menu-link:hover {
            background: #1565C0;
            color: white;
            transform: translateX(5px);
        }

        .menu-link:focus-visible {
            outline: 2px solid #1565C0;
            outline-offset: 2px;
        }

        .menu-link.active {
            background: #1565C0;
            color: white;
            box-shadow: 0 4px 12px rgba(21, 101, 192,0.3);
        }

            .menu-link.active::before {
                content: '';
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 4px;
                height: 24px;
                background: white;
                border-radius: 0 4px 4px 0;
            }

    .icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .menu-expandable {
        cursor: pointer;
    }

    .menu-expandable-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 15px 16px;
        color: #455A64;
        font-weight: 500;
        border-radius: 10px;
        transition: all 0.3s;
    }

        .menu-expandable-header:hover {
            background: rgba(21, 101, 192, 0.08);
            color: #1565C0;
        }

        .menu-expandable-header.active {
            background: rgba(21, 101, 192, 0.12);
            color: #1565C0;
            font-weight: 600;
        }

    .menu-expandable-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .menu-arrow {
        font-size: 12px;
        transition: transform 0.3s;
    }

    .menu-expandable.expanded .menu-arrow {
        transform: rotate(90deg);
    }

    .submenu {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out;
        margin-left: 20px;
        margin-top: 4px;
    }

        .submenu.show {
            max-height: 500px;
            transition: max-height 0.5s ease-in;
        }

    .submenu-item {
        margin: 4px 0;
    }

    .submenu-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        padding-left: 40px;
        color: #78909C;
        text-decoration: none;
        font-weight: 500;
        font-size: 14px;
        border-radius: 8px;
        transition: all 0.3s;
        position: relative;
    }

        .submenu-link::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 6px;
            height: 6px;
            background: #E0E0E0;
            border-radius: 50%;
            transition: all 0.3s;
        }

        .submenu-link:hover {
            background: #F5F7FA;
            color: #1565C0;
            transform: translateX(3px);
        }

            .submenu-link:hover::before {
                background: #1565C0;
                transform: translateY(-50%) scale(1.3);
            }

        .submenu-link.active {
            background: rgba(21, 101, 192, 0.12);
            color: #1565C0;
            font-weight: 600;
        }

            .submenu-link.active::before {
                background: #1565C0;
                width: 8px;
                height: 8px;
            }

    .content {
        flex: 1;
        padding: 40px;
        background: #F5F7FA;
    }

    .content-header {
        margin-bottom: 30px;
    }

        .content-header h1 {
            color: #263238;
            font-size: 28px;
            margin-bottom: 8px;
            font-weight: 800;
        }

        .content-header p {
            color: #78909C;
            margin-bottom: 0;
        }

    .config-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.08);
        margin-bottom: 25px;
        overflow: hidden;
        transition: all 0.3s;
    }

        .config-card:hover {
            box-shadow: 0 5px 25px rgba(0,0,0,0.12);
        }

    .card-header-custom {
        background: #0D47A1;
        color: white;
        padding: 20px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .card-header-custom h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

        .card-header-custom .badge {
            background: rgba(255,255,255,0.22);
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 13px;
            white-space: nowrap;
        }

    .card-body-custom {
        padding: 25px;
    }

    .form-label {
        font-weight: 600;
        color: #455A64;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .form-control,
    .form-select {
        border: 2px solid #E0E0E0;
        border-radius: 10px;
        padding: 12px 15px;
        transition: all 0.3s;
        font-size: 14px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #1565C0;
            box-shadow: 0 0 0 3px rgba(21, 101, 192,0.12);
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #D32F2F;
            box-shadow: 0 0 0 3px rgba(211, 47, 47,0.12);
        }

    .field-help {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        color: #78909C;
    }

    .field-error {
        display: block;
        margin-top: 6px;
        color: #D32F2F;
        font-size: 12px;
        font-weight: 700;
    }

    .btn-primary-custom {
        background: #1565C0;
        border: none;
        padding: 12px 30px;
        border-radius: 10px;
        color: white;
        font-weight: 600;
        transition: all 0.3s;
        cursor: pointer;
    }

        .btn-primary-custom:hover {
            background: #0D47A1;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 71, 161,0.25);
            color: white;
        }

        .btn-primary-custom:disabled {
            background: #78909C;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .btn-outline-custom {
        border: 2px solid #1565C0;
        color: #1565C0;
        padding: 12px 30px;
        border-radius: 10px;
        font-weight: 600;
        background: white;
        transition: all 0.3s;
        cursor: pointer;
    }

        .btn-outline-custom:hover {
            background: #1565C0;
            color: white;
        }

    .stat-mini {
        background: #1565C0;
        color: white;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 20px;
    }

    .stat-mini-value {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .stat-mini-label {
        font-size: 13px;
        opacity: 0.9;
    }

    .alert-danger-custom,
    .alert-success-custom,
    .alert-info-custom {
        border-radius: 10px;
        padding: 15px 20px;
        margin-top: 15px;
        font-weight: 600;
        line-height: 1.5;
    }

    .alert-danger-custom {
        border-left: 4px solid #D32F2F;
        background: #FCE4E4;
        color: #B71C1C;
    }

    .alert-success-custom {
        border-left: 4px solid #38a169;
        background: #f0fff4;
        color: #22543d;
    }

    .alert-info-custom {
        border-left: 4px solid #1565C0;
        background: rgba(21, 101, 192, 0.12);
        color: #0D47A1;
    }

    .modal-header.oc-modal-header {
        background: #0D47A1 !important;
        color: white !important;
        border-radius: 15px 15px 0 0;
        border-bottom: none;
    }

    .calendar-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        gap: 12px;
    }

        .calendar-nav h3 {
            font-size: 20px;
            color: #263238;
            font-weight: 700;
            margin: 0;
            text-align: center;
        }

    .nav-btn {
        background: rgba(21, 101, 192, 0.12);
        border: none;
        color: #1565C0;
        font-weight: 700;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 18px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .nav-btn:hover {
            background: #1565C0;
            color: white;
            transform: scale(1.1);
        }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }

    .cal-header {
        text-align: center;
        padding: 10px 4px;
        font-size: 12px;
        font-weight: 700;
        color: #78909C;
        letter-spacing: 0.05em;
    }

    .cal-day {
        min-height: 70px;
        border-radius: 10px;
        border: 1px solid #E0E0E0;
        padding: 6px;
        cursor: default;
        transition: all 0.2s;
        position: relative;
        background: white;
    }

        .cal-day.empty {
            background: transparent;
            border-color: transparent;
        }

        .cal-day.today {
            border: 2px solid #1565C0;
            background: rgba(21, 101, 192, 0.12);
        }

        .cal-day.holiday {
            background: #FFF7ED;
            border: 2px solid #f97316;
            cursor: pointer;
        }

            .cal-day.holiday:hover {
                transform: scale(1.04);
                box-shadow: 0 4px 16px rgba(249,115,22,0.25);
                z-index: 2;
            }

        .cal-day.weekend {
            background: #F5F7FA;
        }

    .day-number {
        font-size: 13px;
        font-weight: 600;
        color: #455A64;
        margin-bottom: 4px;
        display: block;
    }

    .cal-day.today .day-number {
        color: #1565C0;
    }

    .cal-day.holiday .day-number {
        color: #c2410c;
    }

    .holiday-dot {
        font-size: 10px;
        font-weight: 700;
        color: #f97316;
        background: #ffedd5;
        padding: 2px 5px;
        border-radius: 4px;
        display: block;
        line-height: 1.4;
        margin-top: 2px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 100%;
    }

    .months-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .month-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #E0E0E0;
        padding: 15px;
        transition: box-shadow 0.2s;
    }

        .month-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        }

    .month-title {
        text-align: center;
        font-weight: 700;
        font-size: 14px;
        color: #0D47A1;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .mini-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
    }

    .mini-header {
        font-size: 9px;
        text-align: center;
        color: #78909C;
        font-weight: 700;
        padding: 2px 0;
    }

    .mini-day {
        font-size: 10px;
        text-align: center;
        padding: 3px 1px;
        border-radius: 4px;
        cursor: default;
        color: #455A64;
    }

        .mini-day.holiday-mini {
            background: #f97316;
            color: white;
            font-weight: 700;
            border-radius: 50%;
            cursor: pointer;
        }

            .mini-day.holiday-mini:hover {
                transform: scale(1.3);
            }

        .mini-day.today-mini {
            outline: 2px solid #1565C0;
            border-radius: 50%;
        }

        .mini-day.weekend-mini {
            color: #78909C;
        }

        .mini-day.empty-mini {
            color: transparent;
        }

    .view-toggle {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .toggle-btn {
        padding: 8px 20px;
        border-radius: 8px;
        border: 2px solid #1565C0;
        background: white;
        color: #1565C0;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .toggle-btn.active {
            background: #1565C0;
            color: white;
        }

    .empty-calendar-message {
        background: #F5F7FA;
        border: 1px dashed #E0E0E0;
        border-radius: 12px;
        padding: 20px;
        color: #78909C;
        text-align: center;
        font-weight: 600;
        margin-bottom: 20px;
        display: none;
    }

    @@media (max-width: 900px) {
        .months-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .main-layout {
            flex-direction: column;
        }

        .sidebar {
            width: 100%;
            position: static;
            max-height: none;
        }

        .content {
            padding: 25px 15px;
        }

        .months-grid {
            grid-template-columns: 1fr;
        }

        .calendar-grid {
            gap: 2px;
        }

        .cal-day {
            min-height: 60px;
            padding: 4px;
        }

        .holiday-dot {
            font-size: 9px;
        }
    }

</style>

<div class="main-layout">
    <div class="sidebar">
        <div class="menu-item">
            <a href="/Home/AdminHome" class="menu-link">
                <div class="icon">📊</div>
                Dashboard
            </a>
        </div>

        <div class="menu-item">
            <a href="/Admin/VerMarcas" class="menu-link">
                <div class="icon">⏰</div>
                Marcas de Asistencia
            </a>
        </div>

        <div class="menu-item menu-expandable expanded" onclick="toggleSubmenu(this)">
            <div class="menu-expandable-header active">
                <div class="menu-expandable-left">
                    <div class="icon">⚙️</div>
                    <span>Configuración y Políticas</span>
                </div>
                <div class="menu-arrow">▶</div>
            </div>

            <div class="submenu show">
                <div class="submenu-item">
                    <a href="/Horarios/HorariosConfig" class="submenu-link">⏰ Horarios</a>
                </div>
                <div class="submenu-item">
                    <a href="/Feriados/FeriadosConfig" class="submenu-link active">📅 Feriados</a>
                </div>
                <div class="submenu-item">
                    <a href="/Bono/GestionBonos" class="submenu-link">🎁 Bonos</a>
                </div>
            </div>
        </div>

        <div class="menu-item">
            <a href="/Bono/AsignarBono" class="menu-link">
                <div class="icon">💵</div>
                Asignación de Bonos
            </a>
        </div>

        <div class="menu-item">
            <a href="/AdminGestionUsuarios/GestionUsuarios" class="menu-link">
                <div class="icon">📝</div>
                Gestión de Empleados
            </a>
        </div>

        <div class="menu-item">
            <a href="/Admin/RankingPuntualidad" class="menu-link">
                <div class="icon">⏱️</div>
                Indicadores de Puntualidad
            </a>
        </div>

        <div class="menu-item">
            <a href="/Admin/Reportes" class="menu-link">
                <div class="icon">📄</div>
                Reportes
            </a>
        </div>
    </div>

    <div class="content">
        <div class="content-header">
            <h1>📅 Calendario Laboral</h1>
            <p>Administre los feriados nacionales de Costa Rica y días especiales de la organización.</p>
        </div>

        <div id="globalAlert" style="display:none;"></div>

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="stat-mini">
                    <div class="stat-mini-value" id="totalHolidays">-</div>
                    <div class="stat-mini-label">Feriados del Año</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-mini">
                    <div class="stat-mini-value" id="noLaborables">-</div>
                    <div class="stat-mini-label">No Laborables</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-mini">
                    <div class="stat-mini-value" id="nextHoliday">-</div>
                    <div class="stat-mini-label">Próximo Feriado</div>
                </div>
            </div>
        </div>

        <div class="config-card">
            <div class="card-header-custom">
                <h2>➕ Registrar Nuevo Feriado</h2>
                <span class="badge">Registro manual</span>
            </div>

            <div class="card-body-custom">
                <div id="formAlert" style="display:none;"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Fecha del Feriado <span style="color:#D32F2F;">*</span></label>
                        <input type="date" id="holidayDate" class="form-control" min="1900-01-01" max="2200-12-31">
                        <span class="field-error" id="holidayDateError"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Tipo de día <span style="color:#D32F2F;">*</span></label>
                        <select id="holidayLaborable" class="form-select">
                            <option value="false">No laborable</option>
                            <option value="true">Laborable / día especial</option>
                        </select>
                        <small class="field-help">Seleccione si el día se trabaja o no.</small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Nombre del Feriado <span style="color:#D32F2F;">*</span></label>
                        <input type="text" id="holidayName" class="form-control" maxlength="100" placeholder="Ej: Día de la Independencia">
                        <span class="field-error" id="holidayNameError"></span>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-12">
                        <label class="form-label">Descripción</label>
                        <textarea id="holidayDescription" class="form-control" rows="2" maxlength="250" placeholder="Agregue una nota opcional para este feriado..."></textarea>
                        <small class="field-help">Este campo es opcional.</small>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 flex-wrap">
                    <button class="btn btn-primary-custom" id="btnGuardarFeriado" onclick="guardarFeriado()">
                        Guardar Feriado
                    </button>

                    <button class="btn btn-outline-custom" onclick="resetForm()">
                        Limpiar
                    </button>
                </div>
            </div>
        </div>

        <div class="config-card">
            <div class="card-header-custom">
                <h2>📆 Feriados Registrados</h2>
                <span class="badge" id="holidayCount">Cargando...</span>
            </div>

            <div class="card-body-custom">
                <div class="view-toggle">
                    <button class="toggle-btn active" id="btnMensual" onclick="setView('mensual')">
                        Vista Mensual
                    </button>

                    <button class="toggle-btn" id="btnAnual" onclick="setView('anual')">
                        Vista Anual
                    </button>
                </div>

                <div id="emptyCalendarMessage" class="empty-calendar-message">
                    No hay feriados registrados para el año seleccionado.
                </div>

                <div id="viewMensual">
                    <div class="calendar-nav">
                        <button class="nav-btn" onclick="changeMonth(-1)" title="Mes anterior">‹</button>
                        <h3 id="calendarTitle"></h3>
                        <button class="nav-btn" onclick="changeMonth(1)" title="Mes siguiente">›</button>
                    </div>

                    <div class="calendar-grid" id="calendarGrid">
                        <div class="cal-header">Dom</div>
                        <div class="cal-header">Lun</div>
                        <div class="cal-header">Mar</div>
                        <div class="cal-header">Mié</div>
                        <div class="cal-header">Jue</div>
                        <div class="cal-header">Vie</div>
                        <div class="cal-header">Sáb</div>
                    </div>
                </div>

                <div id="viewAnual" style="display:none;">
                    <div class="calendar-nav">
                        <button class="nav-btn" onclick="changeYear(-1)" title="Año anterior">‹</button>
                        <h3 id="yearTitle"></h3>
                        <button class="nav-btn" onclick="changeYear(1)" title="Año siguiente">›</button>
                    </div>

                    <div class="months-grid" id="monthsGrid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:15px;border:none;">
            <div class="modal-header oc-modal-header">
                <h5 class="modal-title">Editar Feriado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <div id="editAlert" style="display:none;"></div>

                <input type="hidden" id="editId">

                <div class="mb-3">
                    <label class="form-label">Fecha <span style="color:#D32F2F;">*</span></label>
                    <input type="date" id="editDate" class="form-control" min="1900-01-01" max="2200-12-31">
                    <span class="field-error" id="editDateError"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo de día <span style="color:#D32F2F;">*</span></label>
                    <select id="editLaborable" class="form-select">
                        <option value="false">No laborable</option>
                        <option value="true">Laborable / día especial</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre <span style="color:#D32F2F;">*</span></label>
                    <input type="text" id="editName" class="form-control" maxlength="100">
                    <span class="field-error" id="editNameError"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea id="editDescription" class="form-control" rows="2" maxlength="250"></textarea>
                    <small class="field-help">Este campo es opcional.</small>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary-custom flex-fill" id="btnGuardarEdicion" onclick="guardarEdicion()">
                        Guardar Cambios
                    </button>

                    <button class="btn btn-outline-custom" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius:15px;border:none;">
            <div class="modal-header oc-modal-header">
                <h5 class="modal-title" id="detailTitle">Detalle del Feriado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <p><strong>Fecha:</strong> <span id="detailFecha"></span></p>
                <p class="mt-2"><strong>Nombre:</strong> <span id="detailNombre"></span></p>
                <p class="mt-2"><strong>Tipo de día:</strong> <span id="detailLaborable"></span></p>
                <p class="mt-2" id="detailDescWrap"><strong>Descripción:</strong> <span id="detailDesc"></span></p>

                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary-custom flex-fill" onclick="abrirEditar(currentHolidayId)">
                        Editar
                    </button>

                    <button class="btn" style="background:#FCE4E4;color:#B71C1C;border-radius:10px;font-weight:600;padding:12px;" onclick="eliminarFeriado(currentHolidayId)">
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let holidays = [];
    let currentDate = new Date();
    let currentYear = new Date().getFullYear();
    let loadedYear = null;
    let currentView = 'mensual';
    let currentHolidayId = null;

    const MIN_DATE = '1900-01-01';
    const MAX_DATE = '2200-12-31';

    const MONTHS = [
        'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
        'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
    ];

    const MONTHS_SHORT = [
        'Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun',
        'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'
    ];

    function toggleSubmenu(element) {
        const submenu = element.querySelector('.submenu');
        const header = element.querySelector('.menu-expandable-header');

        element.classList.toggle('expanded');
        submenu.classList.toggle('show');

        if (element.classList.contains('expanded')) {
            header.classList.add('active');
        } else {
            header.classList.remove('active');
        }
    }

    function escapeHtml(value) {
        if (value === null || value === undefined) {
            return '';
        }

        return value.toString()
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function limpiarErroresFormulario() {
        ['holidayDate', 'holidayName', 'editDate', 'editName'].forEach(id => {
            const input = document.getElementById(id);
            if (input) {
                input.classList.remove('is-invalid');
            }
        });

        ['holidayDateError', 'holidayNameError', 'editDateError', 'editNameError'].forEach(id => {
            const error = document.getElementById(id);
            if (error) {
                error.textContent = '';
            }
        });
    }

    function marcarError(inputId, errorId, mensaje) {
        const input = document.getElementById(inputId);
        const error = document.getElementById(errorId);

        if (input) {
            input.classList.add('is-invalid');
        }

        if (error) {
            error.textContent = mensaje;
        }
    }

    function fechaDentroDeRango(fecha) {
        return fecha >= MIN_DATE && fecha <= MAX_DATE;
    }

    function validarFeriado(fecha, nombre, modo) {
        let valido = true;

        if (!fecha) {
            valido = false;
            marcarError(
                modo === 'editar' ? 'editDate' : 'holidayDate',
                modo === 'editar' ? 'editDateError' : 'holidayDateError',
                'Seleccione la fecha del feriado.'
            );
        } else if (!fechaDentroDeRango(fecha)) {
            valido = false;
            marcarError(
                modo === 'editar' ? 'editDate' : 'holidayDate',
                modo === 'editar' ? 'editDateError' : 'holidayDateError',
                'La fecha debe estar entre 1900 y 2200.'
            );
        }

        if (!nombre) {
            valido = false;
            marcarError(
                modo === 'editar' ? 'editName' : 'holidayName',
                modo === 'editar' ? 'editNameError' : 'holidayNameError',
                'Ingrese el nombre del feriado.'
            );
        } else if (nombre.length > 100) {
            valido = false;
            marcarError(
                modo === 'editar' ? 'editName' : 'holidayName',
                modo === 'editar' ? 'editNameError' : 'holidayNameError',
                'El nombre no puede superar los 100 caracteres.'
            );
        }

        return valido;
    }

    async function leerRespuesta(res) {
        try {
            return await res.json();
        } catch {
            return {
                mensaje: 'No se recibió una respuesta válida del sistema.'
            };
        }
    }

    function setButtonLoading(buttonId, loading, textLoading, textNormal) {
        const btn = document.getElementById(buttonId);

        if (!btn) {
            return;
        }

        btn.disabled = loading;
        btn.textContent = loading ? textLoading : textNormal;
    }

    async function cargarFeriados(anio) {
        try {
            loadedYear = anio;
            document.getElementById('holidayCount').textContent = 'Cargando...';

            const res = await fetch('/Feriados/GetAll?anio=' + anio);
            const data = await leerRespuesta(res);

            if (!res.ok) {
                showAlert('globalAlert', data.mensaje || 'No se pudieron cargar los feriados registrados.', 'danger', 6000);
                holidays = [];
                updateStats(anio);
                renderCalendar();
                return;
            }

            holidays = Array.isArray(data) ? data : [];

            updateStats(anio);
            renderCalendar();

            if (holidays.length === 0) {
                showAlert('globalAlert', 'No hay feriados registrados para el año seleccionado.', 'info', 4000);
            }
        } catch {
            showAlert('globalAlert', 'No se pudieron cargar los feriados en este momento. Intente nuevamente.', 'danger', 6000);
            holidays = [];
            updateStats(anio);
            renderCalendar();
        }
    }

    async function guardarFeriado() {
        limpiarErroresFormulario();

        const fecha = document.getElementById('holidayDate').value;
        const nombre = document.getElementById('holidayName').value.trim();
        const laborable = document.getElementById('holidayLaborable').value === 'true';
        const descripcion = document.getElementById('holidayDescription').value.trim();

        if (!validarFeriado(fecha, nombre, 'crear')) {
            showAlert('formAlert', 'Revise los campos marcados antes de guardar.', 'danger');
            return;
        }

        try {
            setButtonLoading('btnGuardarFeriado', true, 'Guardando...', 'Guardar Feriado');

            const res = await fetch('/Feriados/Crear', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ nombre, fecha, esLaborable: laborable, descripcion })
            });

            const data = await leerRespuesta(res);

            if (res.ok) {
                showAlert('formAlert', data.mensaje || 'Feriado creado correctamente.', 'success');

                const fechaNueva = new Date(fecha + 'T00:00:00');
                currentDate = fechaNueva;
                currentYear = fechaNueva.getFullYear();

                resetForm(false);
                await cargarFeriados(currentYear);
            } else {
                showAlert('formAlert', data.mensaje || 'No se pudo guardar el feriado. Intente nuevamente.', 'danger');
            }
        } catch {
            showAlert('formAlert', 'No se pudo guardar el feriado. Intente nuevamente.', 'danger');
        } finally {
            setButtonLoading('btnGuardarFeriado', false, 'Guardando...', 'Guardar Feriado');
        }
    }

    async function abrirEditar(id) {
        try {
            const detailModal = bootstrap.Modal.getInstance(document.getElementById('detailModal'));

            if (detailModal) {
                detailModal.hide();
            }

            limpiarErroresFormulario();

            const res = await fetch('/Feriados/ObtenerPorId?id=' + id);
            const data = await leerRespuesta(res);

            if (!res.ok) {
                showAlert('globalAlert', data.mensaje || 'No se pudo consultar el feriado seleccionado.', 'danger');
                return;
            }

            document.getElementById('editId').value = data.idFeriado;
            document.getElementById('editDate').value = data.fecha;
            document.getElementById('editLaborable').value = data.esLaborable ? 'true' : 'false';
            document.getElementById('editName').value = data.nombre;
            document.getElementById('editDescription').value = data.descripcion || '';
            document.getElementById('editAlert').style.display = 'none';

            new bootstrap.Modal(document.getElementById('editModal')).show();
        } catch {
            showAlert('globalAlert', 'No se pudo abrir la edición del feriado. Intente nuevamente.', 'danger');
        }
    }

    async function guardarEdicion() {
        limpiarErroresFormulario();

        const id = parseInt(document.getElementById('editId').value);
        const fecha = document.getElementById('editDate').value;
        const nombre = document.getElementById('editName').value.trim();
        const laborable = document.getElementById('editLaborable').value === 'true';
        const descripcion = document.getElementById('editDescription').value.trim();

        if (!validarFeriado(fecha, nombre, 'editar')) {
            showAlert('editAlert', 'Revise los campos marcados antes de guardar.', 'danger');
            return;
        }

        try {
            setButtonLoading('btnGuardarEdicion', true, 'Guardando...', 'Guardar Cambios');

            const res = await fetch('/Feriados/Editar', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idFeriado: id, nombre, fecha, esLaborable: laborable, descripcion })
            });

            const data = await leerRespuesta(res);

            if (res.ok) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('editModal'));

                if (modal) {
                    modal.hide();
                }

                const fechaEditada = new Date(fecha + 'T00:00:00');
                currentDate = fechaEditada;
                currentYear = fechaEditada.getFullYear();

                await cargarFeriados(currentYear);
                showAlert('globalAlert', data.mensaje || 'Feriado actualizado correctamente.', 'success');
            } else {
                showAlert('editAlert', data.mensaje || 'No se pudo actualizar el feriado. Intente nuevamente.', 'danger');
            }
        } catch {
            showAlert('editAlert', 'No se pudo actualizar el feriado. Intente nuevamente.', 'danger');
        } finally {
            setButtonLoading('btnGuardarEdicion', false, 'Guardando...', 'Guardar Cambios');
        }
    }

    async function eliminarFeriado(id) {
        if (!id) {
            showAlert('globalAlert', 'Seleccione un feriado válido para eliminar.', 'danger');
            return;
        }

        if (!confirm('¿Está seguro de que desea eliminar este feriado?')) {
            return;
        }

        try {
            const detailModal = bootstrap.Modal.getInstance(document.getElementById('detailModal'));

            if (detailModal) {
                detailModal.hide();
            }

            const res = await fetch('/Feriados/Eliminar?id=' + id, {
                method: 'DELETE'
            });

            const data = await leerRespuesta(res);

            if (res.ok) {
                await cargarFeriados(getVisibleYear());
                showAlert('globalAlert', data.mensaje || 'Feriado eliminado correctamente.', 'success');
            } else {
                showAlert('globalAlert', data.mensaje || 'No se pudo eliminar el feriado. Intente nuevamente.', 'danger');
            }
        } catch {
            showAlert('globalAlert', 'No se pudo eliminar el feriado. Intente nuevamente.', 'danger');
        }
    }

    function updateStats(anio) {
        document.getElementById('totalHolidays').textContent = holidays.length;

        const noLaborables = holidays.filter(h => !h.esLaborable).length;
        document.getElementById('noLaborables').textContent = noLaborables;

        document.getElementById('holidayCount').textContent = holidays.length + ' registrados en ' + anio;

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const proximos = holidays
            .filter(h => new Date(h.fecha + 'T00:00:00') >= today)
            .sort((a, b) => new Date(a.fecha) - new Date(b.fecha));

        if (proximos.length > 0) {
            const d = new Date(proximos[0].fecha + 'T00:00:00');
            document.getElementById('nextHoliday').textContent = d.getDate() + ' ' + MONTHS_SHORT[d.getMonth()];
        } else {
            document.getElementById('nextHoliday').textContent = '-';
        }

        const emptyMessage = document.getElementById('emptyCalendarMessage');

        if (emptyMessage) {
            emptyMessage.style.display = holidays.length === 0 ? 'block' : 'none';
        }
    }

    function getVisibleYear() {
        if (currentView === 'anual') {
            return currentYear;
        }

        return currentDate.getFullYear();
    }

    async function setView(view) {
        currentView = view;

        document.getElementById('viewMensual').style.display = view === 'mensual' ? '' : 'none';
        document.getElementById('viewAnual').style.display = view === 'anual' ? '' : 'none';

        document.getElementById('btnMensual').classList.toggle('active', view === 'mensual');
        document.getElementById('btnAnual').classList.toggle('active', view === 'anual');

        const anio = getVisibleYear();

        if (loadedYear !== anio) {
            await cargarFeriados(anio);
        } else {
            renderCalendar();
        }
    }

    function renderCalendar() {
        if (currentView === 'mensual') {
            renderMensual();
        } else {
            renderAnual();
        }
    }

    async function changeMonth(dir) {
        currentDate.setMonth(currentDate.getMonth() + dir);

        const anio = currentDate.getFullYear();
        currentYear = anio;

        if (loadedYear !== anio) {
            await cargarFeriados(anio);
        } else {
            renderMensual();
        }
    }

    function renderMensual() {
        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();

        document.getElementById('calendarTitle').textContent = MONTHS[month] + ' ' + year;

        const grid = document.getElementById('calendarGrid');

        grid.innerHTML = `
            <div class="cal-header">Dom</div>
            <div class="cal-header">Lun</div>
            <div class="cal-header">Mar</div>
            <div class="cal-header">Mié</div>
            <div class="cal-header">Jue</div>
            <div class="cal-header">Vie</div>
            <div class="cal-header">Sáb</div>
        `;

        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        for (let i = 0; i < firstDay; i++) {
            grid.insertAdjacentHTML('beforeend', '<div class="cal-day empty"></div>');
        }

        for (let d = 1; d <= daysInMonth; d++) {
            const dateStr = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
            const dayDate = new Date(year, month, d);

            const isToday = dayDate.getTime() === today.getTime();
            const isWeekend = dayDate.getDay() === 0 || dayDate.getDay() === 6;
            const holiday = holidays.find(h => h.fecha === dateStr);

            let cls = 'cal-day';

            if (isToday) {
                cls += ' today';
            }

            if (holiday) {
                cls += ' holiday';
            } else if (isWeekend) {
                cls += ' weekend';
            }

            const badge = holiday
                ? '<span class="holiday-dot">🎌 ' + escapeHtml(holiday.nombre) + '</span>'
                : '';

            const onclick = holiday
                ? 'onclick="mostrarDetalle(' + holiday.idFeriado + ')"'
                : '';

            grid.insertAdjacentHTML('beforeend', `
                <div class="${cls}" ${onclick} title="${holiday ? escapeHtml(holiday.nombre) : ''}">
                    <span class="day-number">${d}</span>
                    ${badge}
                </div>
            `);
        }
    }

    async function changeYear(dir) {
        currentYear += dir;

        if (loadedYear !== currentYear) {
            await cargarFeriados(currentYear);
        } else {
            renderAnual();
        }
    }

    function renderAnual() {
        document.getElementById('yearTitle').textContent = currentYear;

        const container = document.getElementById('monthsGrid');
        container.innerHTML = '';

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        for (let m = 0; m < 12; m++) {
            const firstDay = new Date(currentYear, m, 1).getDay();
            const daysInMonth = new Date(currentYear, m + 1, 0).getDate();

            let daysHtml = '';

            ['D', 'L', 'M', 'X', 'J', 'V', 'S'].forEach(h => {
                daysHtml += '<div class="mini-header">' + h + '</div>';
            });

            for (let i = 0; i < firstDay; i++) {
                daysHtml += '<div class="mini-day empty-mini"></div>';
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const dateStr = currentYear + '-' + String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
                const dayDate = new Date(currentYear, m, d);

                const isToday = dayDate.getTime() === today.getTime();
                const isWeekend = dayDate.getDay() === 0 || dayDate.getDay() === 6;
                const holiday = holidays.find(h => h.fecha === dateStr);

                let cls = 'mini-day';

                if (holiday) {
                    cls += ' holiday-mini';
                } else if (isWeekend) {
                    cls += ' weekend-mini';
                }

                if (isToday) {
                    cls += ' today-mini';
                }

                const onclick = holiday
                    ? 'onclick="mostrarDetalle(' + holiday.idFeriado + ')"'
                    : '';

                daysHtml += '<div class="' + cls + '" ' + onclick + ' title="' + (holiday ? escapeHtml(holiday.nombre) : '') + '">' + d + '</div>';
            }

            container.insertAdjacentHTML('beforeend', `
                <div class="month-card">
                    <div class="month-title">${MONTHS[m]}</div>
                    <div class="mini-grid">${daysHtml}</div>
                </div>
            `);
        }
    }

    function mostrarDetalle(id) {
        const h = holidays.find(x => x.idFeriado === id);

        if (!h) {
            showAlert('globalAlert', 'No se encontró el detalle del feriado seleccionado.', 'danger');
            return;
        }

        currentHolidayId = id;

        const d = new Date(h.fecha + 'T00:00:00');

        document.getElementById('detailTitle').textContent = 'Detalle del Feriado';
        document.getElementById('detailFecha').textContent = d.getDate() + ' de ' + MONTHS[d.getMonth()] + ' ' + d.getFullYear();
        document.getElementById('detailNombre').textContent = h.nombre;
        document.getElementById('detailLaborable').textContent = h.esLaborable ? 'Laborable / día especial' : 'No laborable';

        const descWrap = document.getElementById('detailDescWrap');

        if (h.descripcion) {
            document.getElementById('detailDesc').textContent = h.descripcion;
            descWrap.style.display = '';
        } else {
            document.getElementById('detailDesc').textContent = '';
            descWrap.style.display = 'none';
        }

        new bootstrap.Modal(document.getElementById('detailModal')).show();
    }

    function resetForm(ocultarAlerta = true) {
        document.getElementById('holidayDate').value = '';
        document.getElementById('holidayName').value = '';
        document.getElementById('holidayLaborable').value = 'false';
        document.getElementById('holidayDescription').value = '';

        limpiarErroresFormulario();

        if (ocultarAlerta) {
            document.getElementById('formAlert').style.display = 'none';
        }
    }

    function showAlert(containerId, msg, type, timeout = 5000) {
        const el = document.getElementById(containerId);

        if (!el) {
            return;
        }

        if (type === 'success') {
            el.className = 'alert-success-custom';
        } else if (type === 'info') {
            el.className = 'alert-info-custom';
        } else {
            el.className = 'alert-danger-custom';
        }

        el.innerHTML = escapeHtml(msg);
        el.style.display = 'block';

        if (timeout > 0) {
            setTimeout(() => {
                el.style.display = 'none';
            }, timeout);
        }
    }

    document.addEventListener('DOMContentLoaded', async function () {
        const anioInicial = currentDate.getFullYear();
        currentYear = anioInicial;
        await cargarFeriados(anioInicial);
    });
</script>