@{
    ViewData["Title"] = "Solicitudes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .main-layout {
        display: flex;
        min-height: 600px;
    }

    .sidebar {
        width: 280px;
        background: #ffffff;
        padding: 30px 20px;
        border-right: 1px solid #e0e0e0;
        box-shadow: 2px 0 10px rgba(0,0,0,0.03);
    }

    .menu-item {
        padding: 0;
        margin: 4px 0;
        border-radius: 10px;
        transition: all 0.3s;
        position: relative;
    }

    .menu-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px 20px;
        color: #4a5568;
        text-decoration: none;
        font-weight: 500;
        font-size: 15px;
        border-radius: 10px;
        transition: all 0.3s;
        position: relative;
    }

        .menu-link:hover {
            background: #667eea;
            color: white;
            transform: translateX(5px);
        }

        .menu-link.active {
            background: #667eea;
            color: white;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

            .menu-link.active::before {
                content: '';
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 4px;
                height: 24px;
                background: white;
                border-radius: 0 4px 4px 0;
            }

    .icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .content {
        flex: 1;
        padding: 40px;
        background: #f5f7fa;
    }

    .content-header {
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .content-header h1 {
            color: #2d3748;
            font-size: 28px;
            margin-bottom: 8px;
        }

        .content-header p {
            color: #718096;
            font-size: 14px;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: transform 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .stat-icon {
        font-size: 20px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: bold;
        color: #2d3748;
        margin-bottom: 3px;
    }

    .stat-label {
        color: #718096;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
    }

    .tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        background: white;
        padding: 8px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .tab {
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        color: #4a5568;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
        flex: 1;
        justify-content: center;
    }

        .tab:hover {
            background: #f7fafc;
        }

        .tab.active {
            background: #667eea;
            color: white;
        }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

    .form-section {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }

        .form-section h2 {
            color: #2d3748;
            margin-bottom: 15px;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group label {
            color: #4a5568;
            font-weight: 600;
            font-size: 13px;
        }

            .form-group label .required {
                color: #e53e3e;
                margin-left: 2px;
            }

        .form-group select,
        .form-group input,
        .form-group textarea {
            padding: 10px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            transition: all 0.3s;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

            .form-group select:focus,
            .form-group input:focus,
            .form-group textarea:focus {
                outline: none;
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        .form-group.error input,
        .form-group.error select,
        .form-group.error textarea {
            border-color: #e53e3e;
        }

    .error-message {
        color: #e53e3e;
        font-size: 11px;
        margin-top: 3px;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 80px;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .hidden {
        display: none !important;
    }

    .field-help {
        color: #718096;
        font-size: 11px;
        line-height: 1.4;
    }

    .tipo-info {
        background: #ebf8ff;
        color: #2c5282;
        border-left: 3px solid #4299e1;
        padding: 12px 15px;
        border-radius: 8px;
        font-size: 13px;
        line-height: 1.5;
    }

    .admin-note {
        background: #f7fafc;
        color: #4a5568;
        border-left: 3px solid #667eea;
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 12px;
        margin-top: 8px;
        line-height: 1.5;
    }

    .file-upload {
        border: 2px dashed #cbd5e0;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
    }

        .file-upload:hover {
            border-color: #667eea;
            background: #f7fafc;
        }

    .file-upload-icon {
        font-size: 32px;
        margin-bottom: 10px;
        opacity: 0.5;
    }

    .file-upload-text {
        color: #4a5568;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .file-upload-hint {
        color: #718096;
        font-size: 11px;
    }

    .file-input {
        display: none;
    }

    .uploaded-files {
        margin-top: 15px;
    }

    .uploaded-file {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: #f7fafc;
        border-radius: 8px;
        margin-bottom: 8px;
    }

    .file-icon {
        font-size: 20px;
    }

    .file-info {
        flex: 1;
    }

    .file-name {
        color: #2d3748;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .file-size {
        color: #718096;
        font-size: 11px;
    }

    .file-remove {
        background: #fed7d7;
        color: #c53030;
        border: none;
        padding: 6px 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 11px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .file-remove:hover {
            background: #fc8181;
            color: white;
        }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-primary {
        background: #667eea;
        color: white;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

    .btn-secondary {
        background: #e2e8f0;
        color: #4a5568;
    }

        .btn-secondary:hover {
            background: #cbd5e0;
        }

    .btn-success {
        background: #48bb78;
        color: white;
    }

        .btn-success:hover {
            background: #38a169;
        }

    .btn-danger {
        background: #e53e3e;
        color: white;
    }

        .btn-danger:hover {
            background: #c53030;
        }

    .btn-info {
        background: #667eea;
        color: white;
        padding: 6px 12px;
        font-size: 12px;
    }

        .btn-info:hover {
            background: #5a67d8;
        }

    .btn-group {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .filter-section {
        background: white;
        padding: 15px 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }

        .filter-section h3 {
            color: #2d3748;
            margin-bottom: 12px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        margin-bottom: 12px;
    }

    .requests-section {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f0f0;
    }

        .section-header h2 {
            color: #2d3748;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .request-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 10px;
        margin-bottom: 12px;
        border-left: 3px solid #667eea;
        transition: all 0.3s;
    }

        .request-card:hover {
            background: #e8edf3;
            transform: translateX(3px);
        }

        .request-card.pendiente {
            border-left-color: #f59e0b;
        }

        .request-card.aprobada {
            border-left-color: #48bb78;
        }

        .request-card.rechazada {
            border-left-color: #e53e3e;
        }

        .request-card.cancelada {
            border-left-color: #718096;
        }

        .request-card.cancelado {
            border-left-color: #718096;
        }

    .request-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .request-info {
        flex: 1;
    }

    .request-title {
        color: #2d3748;
        font-weight: 700;
        margin-bottom: 5px;
        font-size: 14px;
        text-transform: capitalize;
    }

    .request-details {
        color: #718096;
        font-size: 12px;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .request-detail-item {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .request-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-warning {
        background: #feebc8;
        color: #7c2d12;
    }

    .badge-success {
        background: #c6f6d5;
        color: #22543d;
    }

    .badge-danger {
        background: #fed7d7;
        color: #742a2a;
    }

    .badge-info {
        background: #bee3f8;
        color: #2c5282;
    }

    .badge-secondary {
        background: #e2e8f0;
        color: #4a5568;
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #718096;
    }

    .empty-state-icon {
        font-size: 48px;
        margin-bottom: 15px;
        opacity: 0.5;
    }

    .empty-state h3 {
        color: #4a5568;
        margin-bottom: 8px;
        font-size: 16px;
    }

    .empty-state p {
        font-size: 13px;
    }

    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal.show {
            display: flex;
        }

    .modal-content {
        background: white;
        border-radius: 12px;
        padding: 25px;
        max-width: 650px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f0f0;
    }

        .modal-header h3 {
            color: #2d3748;
            font-size: 18px;
        }

    .btn-close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #718096;
        padding: 0;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.3s;
    }

        .btn-close:hover {
            background: #e2e8f0;
            color: #2d3748;
        }

    .detail-row {
        display: flex;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 700;
        color: #4a5568;
        width: 160px;
        flex-shrink: 0;
        font-size: 13px;
    }

    .detail-value {
        color: #2d3748;
        flex: 1;
        font-size: 13px;
        white-space: pre-line;
    }

    .alert {
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
    }

    .alert-success {
        background: #c6f6d5;
        color: #22543d;
        border-left: 3px solid #48bb78;
    }

    .alert-error {
        background: #fed7d7;
        color: #742a2a;
        border-left: 3px solid #e53e3e;
    }

    .alert-warning {
        background: #feebc8;
        color: #7c2d12;
        border-left: 3px solid #f59e0b;
    }

    .alert-info {
        background: #bee3f8;
        color: #2c5282;
        border-left: 3px solid #4299e1;
    }
</style>

<div class="main-layout">
    <div class="sidebar">
        <div class="menu-item">
            <a href="/Home/ColaboradorHome" class="menu-link">
                <div class="icon">⏰</div>
                Marcas
            </a>
        </div>

        <div class="menu-item">
            <a href="/Empleado/HistorialMarcas" class="menu-link">
                <div class="icon">📝</div>
                Mi Historial
            </a>
        </div>

        <div class="menu-item">
            <a href="/Empleado/Solicitudes" class="menu-link active">
                <div class="icon">🗂️</div>
                Mis Solicitudes
            </a>
        </div>

        <div class="menu-item">
            <a href="/Empleado/CalendarioFeriados" class="menu-link">
                <div class="icon">📅</div>
                Calendario de Feriados
            </a>
        </div>

        <div class="menu-item">
            <a href="/Empleado/HistorialBonos" class="menu-link">
                <div class="icon">🏆</div>
                Mis Bonos
            </a>
        </div>
    </div>

    <div class="content">
        <div class="content-header">
            <div>
                <h1>Mis Solicitudes de Permisos</h1>
                <p>Gestiona tus solicitudes según el tipo requerido por recursos humanos</p>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">📌</div>
                </div>
                <div class="stat-value" id="pendingCount">0</div>
                <div class="stat-label">Pendientes</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">✅</div>
                </div>
                <div class="stat-value" id="approvedCount">0</div>
                <div class="stat-label">Aprobadas</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">❌</div>
                </div>
                <div class="stat-value" id="rejectedCount">0</div>
                <div class="stat-label">Rechazadas</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">📊</div>
                </div>
                <div class="stat-value" id="totalCount">0</div>
                <div class="stat-label">Total</div>
            </div>
        </div>

        <div class="tabs">
            <div class="tab active" onclick="switchTab('nueva', this)">
                ➕ Nueva Solicitud
            </div>
            <div class="tab" onclick="switchTab('mis', this)">
                📄 Mis Solicitudes
            </div>
        </div>

        <div id="nuevaTab" class="tab-content active">
            <div id="alertMessage" style="display: none;"></div>

            <div class="form-section">
                <h2>📝 Registrar Nueva Solicitud</h2>

                <form id="solicitudForm">
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>Tipo de Solicitud <span class="required">*</span></label>
                            <select id="tipoSolicitud" required>
                                <option value="">Seleccione un tipo</option>
                            </select>
                            <span class="error-message" id="tipoError"></span>
                        </div>

                        <div class="form-group full-width hidden" id="grupoInfoTipo">
                            <div class="tipo-info" id="infoTipoSolicitud"></div>
                        </div>

                        <div class="form-group hidden" id="grupoPrioridad">
                            <label>Prioridad</label>
                            <select id="prioridad">
                                <option value="normal">Normal</option>
                                <option value="urgente">Urgente</option>
                            </select>
                            <span class="field-help">Usar urgente solo cuando la solicitud requiera atención rápida.</span>
                        </div>

                        <div class="form-group hidden" id="grupoFechaInicio">
                            <label>Fecha Inicio <span class="required">*</span></label>
                            <input type="date" id="fechaInicio">
                            <span class="error-message" id="fechaInicioError"></span>
                        </div>

                        <div class="form-group hidden" id="grupoFechaFin">
                            <label>Fecha Fin <span class="required">*</span></label>
                            <input type="date" id="fechaFin">
                            <span class="error-message" id="fechaFinError"></span>
                        </div>

                        <div class="form-group full-width hidden" id="grupoMotivo">
                            <label id="labelMotivo">Motivo / Descripción</label>
                            <textarea id="motivo" placeholder="Describa el motivo de su solicitud..."></textarea>
                            <span class="error-message" id="motivoError"></span>
                        </div>

                        <div class="form-group hidden" id="grupoParentesco">
                            <label>Parentesco del familiar</label>
                            <input type="text" id="parentescoFamiliar" placeholder="Ejemplo: padre, madre, hermano(a), cónyuge">
                            <span class="field-help">Dato de apoyo para la revisión administrativa.</span>
                        </div>

                        <div class="form-group hidden" id="grupoNombreFamiliar">
                            <label>Nombre del familiar</label>
                            <input type="text" id="nombreFamiliar" placeholder="Nombre del familiar fallecido">
                            <span class="field-help">Opcional, según el documento presentado.</span>
                        </div>

                        <div class="form-group full-width hidden" id="grupoMotivoConstancia">
                            <label>Motivo de la constancia salarial</label>
                            <textarea id="motivoConstancia" placeholder="Ejemplo: trámite bancario, alquiler, estudio, otro..."></textarea>
                            <span class="error-message" id="motivoConstanciaError"></span>
                        </div>

                        <div class="form-group full-width hidden" id="grupoDetalleOtro">
                            <label>Detalle adicional</label>
                            <textarea id="detalleOtro" placeholder="Explique el tipo de solicitud que necesita..."></textarea>
                            <span class="error-message" id="detalleOtroError"></span>
                        </div>

                        <div class="form-group full-width hidden" id="grupoDocumento">
                            <label id="labelDocumento">Adjuntar Documento</label>
                            <div class="file-upload" onclick="document.getElementById('fileInput').click()">
                                <div class="file-upload-icon">📎</div>
                                <div class="file-upload-text" id="textoDocumento">Haz clic para adjuntar archivo</div>
                                <div class="file-upload-hint">PDF, JPG, PNG (Máximo 5MB)</div>
                            </div>
                            <input type="file" id="fileInput" class="file-input" accept=".pdf,.jpg,.jpeg,.png" onchange="handleFileSelect(event)">
                            <span class="error-message" id="fileError"></span>
                            <div id="uploadedFiles" class="uploaded-files"></div>
                        </div>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="btn btn-primary">
                            ✅ Registrar Solicitud
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="clearForm()">
                            🔄 Limpiar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div id="misTab" class="tab-content">
            <div class="filter-section">
                <h3>🔍 Filtrar Solicitudes</h3>
                <div class="filter-grid">
                    <div class="form-group">
                        <label>Estado</label>
                        <select id="filterEstado" onchange="applyFilters()">
                            <option value="">Todos</option>
                            <option value="pendiente">Pendiente</option>
                            <option value="aprobada">Aprobada</option>
                            <option value="rechazada">Rechazada</option>
                            <option value="cancelada">Cancelada</option>
                            <option value="cancelado">Cancelado</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Tipo</label>
                        <select id="filterTipo" onchange="applyFilters()">
                            <option value="">Todos</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Desde</label>
                        <input type="date" id="filterDesde" onchange="applyFilters()">
                    </div>

                    <div class="form-group">
                        <label>Hasta</label>
                        <input type="date" id="filterHasta" onchange="applyFilters()">
                    </div>
                </div>

                <button class="btn btn-secondary" onclick="clearFilters()">
                    🔄 Limpiar Filtros
                </button>
            </div>

            <div class="requests-section">
                <div class="section-header">
                    <h2>📄 Mis Solicitudes</h2>
                    <span class="badge badge-info" id="totalBadge">0 solicitudes</span>
                </div>

                <div id="solicitudesList"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="detailModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>📋 Detalle de Solicitud</h3>
            <button class="btn-close" onclick="closeModal('detailModal')">×</button>
        </div>
        <div id="detailContent"></div>
    </div>
</div>

<div class="modal" id="editModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>✏️ Editar Solicitud</h3>
            <button class="btn-close" onclick="closeModal('editModal')">×</button>
        </div>

        <div id="editContent">
            <form id="editForm">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label>Tipo <span class="required">*</span></label>
                        <select id="editTipoSolicitud" required>
                            <option value="">Seleccione un tipo</option>
                        </select>
                    </div>

                    <div class="form-group full-width hidden" id="editGrupoInfoTipo">
                        <div class="tipo-info" id="editInfoTipoSolicitud"></div>
                    </div>

                    <div class="form-group hidden" id="editGrupoPrioridad">
                        <label>Prioridad</label>
                        <select id="editPrioridad">
                            <option value="normal">Normal</option>
                            <option value="urgente">Urgente</option>
                        </select>
                    </div>

                    <div class="form-group hidden" id="editGrupoFechaInicio">
                        <label>Fecha Inicio <span class="required">*</span></label>
                        <input type="date" id="editFechaInicio">
                    </div>

                    <div class="form-group hidden" id="editGrupoFechaFin">
                        <label>Fecha Fin <span class="required">*</span></label>
                        <input type="date" id="editFechaFin">
                    </div>

                    <div class="form-group full-width hidden" id="editGrupoMotivo">
                        <label id="editLabelMotivo">Motivo / Descripción</label>
                        <textarea id="editMotivo"></textarea>
                    </div>

                    <div class="form-group hidden" id="editGrupoParentesco">
                        <label>Parentesco del familiar</label>
                        <input type="text" id="editParentescoFamiliar">
                    </div>

                    <div class="form-group hidden" id="editGrupoNombreFamiliar">
                        <label>Nombre del familiar</label>
                        <input type="text" id="editNombreFamiliar">
                    </div>

                    <div class="form-group full-width hidden" id="editGrupoMotivoConstancia">
                        <label>Motivo de la constancia salarial</label>
                        <textarea id="editMotivoConstancia"></textarea>
                    </div>

                    <div class="form-group full-width hidden" id="editGrupoDetalleOtro">
                        <label>Detalle adicional</label>
                        <textarea id="editDetalleOtro"></textarea>
                    </div>

                    <div class="form-group full-width hidden" id="editGrupoDocumento">
                        <label id="editLabelDocumento">Documento de Respaldo</label>

                        <div id="archivoActualContainer" style="margin-bottom:10px; display:none;">
                            <div class="uploaded-file">
                                <div class="file-icon">📄</div>
                                <div class="file-info">
                                    <div class="file-name" id="archivoActualNombre"></div>
                                </div>
                                <button type="button" class="file-remove" onclick="eliminarArchivoActual()">
                                    🗑️
                                </button>
                            </div>
                            <button type="button" class="btn btn-info"
                                    style="margin-top:5px;"
                                    onclick="descargarArchivoActual()">
                                ⬇️ Descargar
                            </button>
                        </div>

                        <div class="file-upload" onclick="document.getElementById('editFileInput').click()">
                            <div class="file-upload-icon">📎</div>
                            <div class="file-upload-text" id="editTextoDocumento">Haz clic para adjuntar nuevo archivo</div>
                            <div class="file-upload-hint">PDF, JPG, PNG (Máximo 5MB)</div>
                        </div>

                        <input type="file" id="editFileInput" class="file-input"
                               accept=".pdf,.jpg,.jpeg,.png"
                               onchange="handleEditFileSelect(event)">

                        <div id="editUploadedFiles" class="uploaded-files"></div>
                    </div>
                </div>

                <div class="btn-group" style="margin-top: 15px;">
                    <button type="submit" class="btn btn-success">
                        💾 Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">
                        ❌ Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal" id="cancelModal">
    <div class="modal-content" style="max-width: 450px;">
        <div class="modal-header">
            <h3>⚠️ Confirmar Cancelación</h3>
            <button class="btn-close" onclick="closeModal('cancelModal')">×</button>
        </div>
        <div style="padding: 15px 0;">
            <p style="color: #4a5568; margin-bottom: 15px; font-size: 13px;">
                ¿Está seguro que desea cancelar esta solicitud? Esta acción no se puede deshacer.
            </p>
            <div class="btn-group">
                <button class="btn btn-danger" onclick="confirmCancel()">
                    ✅ Sí, Cancelar
                </button>
                <button class="btn btn-secondary" onclick="closeModal('cancelModal')">
                    ❌ No, Mantener
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let solicitudes = [];
    let tiposSolicitud = [];
    let uploadedFile = null;
    let currentEditId = null;
    let currentCancelId = null;
    let editFile = null;
    let eliminarArchivo = false;
    let archivoActualRuta = null;

    document.addEventListener('DOMContentLoaded', async () => {
        await cargarTiposSolicitud();
        await cargarSolicitudes();

        document.getElementById('solicitudForm').addEventListener('submit', handleFormSubmit);
        document.getElementById('editForm').addEventListener('submit', handleEditSubmit);

        document.getElementById('tipoSolicitud').addEventListener('change', () => actualizarFormularioPorTipo(false));
        document.getElementById('editTipoSolicitud').addEventListener('change', () => actualizarFormularioPorTipo(true));

        actualizarFormularioPorTipo(false);
        actualizarFormularioPorTipo(true);
    });

    function normalizarTexto(texto) {
        return (texto || '')
            .toString()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .trim()
            .toLowerCase();
    }

    function escapeHtml(valor) {
        if (valor === null || valor === undefined) return '';
        return valor.toString()
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function obtenerReglasTipo(nombreTipo) {
        const nombre = normalizarTexto(nombreTipo);

        const esVacaciones = nombre.includes('vacacion');
        const esPermisoPersonal = nombre.includes('permiso personal');
        const esIncapacidad = nombre.includes('incapacidad');
        const esMaternidad = nombre.includes('maternidad');
        const esFallecimiento = nombre.includes('fallecimiento');
        const esConstancia = nombre.includes('constancia salarial');
        const esOtro = nombre === 'otro' || nombre.includes('otro');

        return {
            esVacaciones,
            esPermisoPersonal,
            esIncapacidad,
            esMaternidad,
            esFallecimiento,
            esConstancia,
            esOtro,
            requiereFechas: esVacaciones || esPermisoPersonal || esOtro,
            requiereDocumento: esIncapacidad || esMaternidad || esFallecimiento,
            mostrarDocumento: esIncapacidad || esMaternidad || esFallecimiento || esPermisoPersonal || esOtro,
            mostrarPrioridad: esVacaciones || esPermisoPersonal || esOtro,
            mostrarMotivo: esVacaciones || esPermisoPersonal || esIncapacidad || esMaternidad || esFallecimiento,
            requiereMotivo: esVacaciones || esPermisoPersonal,
            mostrarFallecimiento: esFallecimiento,
            mostrarConstancia: esConstancia,
            mostrarOtro: esOtro,
            gestionAdministrativa: esIncapacidad || esMaternidad || esFallecimiento || esConstancia
        };
    }

    function obtenerTipoPorId(id) {
        return tiposSolicitud.find(t => String(t.idTipoSolicitud) === String(id));
    }

    function setVisible(id, visible) {
        const element = document.getElementById(id);
        if (!element) return;

        if (visible) {
            element.classList.remove('hidden');
        } else {
            element.classList.add('hidden');
        }
    }

    function setRequired(id, required) {
        const element = document.getElementById(id);
        if (!element) return;

        if (required) {
            element.setAttribute('required', 'required');
        } else {
            element.removeAttribute('required');
        }
    }

    function obtenerMensajeTipo(nombreTipo, reglas) {
        if (!nombreTipo) {
            return '';
        }

        if (reglas.esIncapacidad) {
            return 'Para incapacidad, el colaborador solo debe adjuntar el documento de respaldo. La administración revisará la validez, fechas y cantidad de días otorgados.';
        }

        if (reglas.esMaternidad) {
            return 'Para licencia de maternidad, adjunte el documento correspondiente. La administración determinará las fechas oficiales y los días otorgados.';
        }

        if (reglas.esFallecimiento) {
            return 'Para permiso por fallecimiento, adjunte el documento de respaldo. Puede indicar parentesco como dato de apoyo, pero la administración determinará los días aplicables.';
        }

        if (reglas.esConstancia) {
            return 'Para constancia salarial, indique el motivo de la solicitud. La gestión administrativa se encargará de generar el documento correspondiente.';
        }

        if (reglas.esVacaciones) {
            return 'Para vacaciones, indique el rango de fechas solicitado. La administración validará disponibilidad y aprobará los días correspondientes.';
        }

        if (reglas.esPermisoPersonal) {
            return 'Para permiso personal, indique el rango de fechas y el motivo. Puede adjuntar un documento si aplica.';
        }

        if (reglas.esOtro) {
            return 'Para otro tipo de solicitud, indique fechas y detalle del caso para que la administración pueda revisarlo.';
        }

        return 'Complete únicamente la información necesaria para este tipo de solicitud.';
    }

    function actualizarFormularioPorTipo(esEdicion) {
        const prefijo = esEdicion ? 'edit' : '';
        const selectId = esEdicion ? 'editTipoSolicitud' : 'tipoSolicitud';
        const select = document.getElementById(selectId);
        const tipo = obtenerTipoPorId(select?.value);
        const nombreTipo = tipo?.nombreSolicitud || '';
        const reglas = obtenerReglasTipo(nombreTipo);

        const grupoInfo = esEdicion ? 'editGrupoInfoTipo' : 'grupoInfoTipo';
        const info = esEdicion ? 'editInfoTipoSolicitud' : 'infoTipoSolicitud';

        setVisible(grupoInfo, !!nombreTipo);
        document.getElementById(info).textContent = obtenerMensajeTipo(nombreTipo, reglas);

        setVisible(esEdicion ? 'editGrupoPrioridad' : 'grupoPrioridad', reglas.mostrarPrioridad);
        setVisible(esEdicion ? 'editGrupoFechaInicio' : 'grupoFechaInicio', reglas.requiereFechas);
        setVisible(esEdicion ? 'editGrupoFechaFin' : 'grupoFechaFin', reglas.requiereFechas);
        setVisible(esEdicion ? 'editGrupoMotivo' : 'grupoMotivo', reglas.mostrarMotivo);
        setVisible(esEdicion ? 'editGrupoParentesco' : 'grupoParentesco', reglas.mostrarFallecimiento);
        setVisible(esEdicion ? 'editGrupoNombreFamiliar' : 'grupoNombreFamiliar', reglas.mostrarFallecimiento);
        setVisible(esEdicion ? 'editGrupoMotivoConstancia' : 'grupoMotivoConstancia', reglas.mostrarConstancia);
        setVisible(esEdicion ? 'editGrupoDetalleOtro' : 'grupoDetalleOtro', reglas.mostrarOtro);
        setVisible(esEdicion ? 'editGrupoDocumento' : 'grupoDocumento', reglas.mostrarDocumento);

        setRequired(esEdicion ? 'editFechaInicio' : 'fechaInicio', reglas.requiereFechas);
        setRequired(esEdicion ? 'editFechaFin' : 'fechaFin', reglas.requiereFechas);
        setRequired(esEdicion ? 'editMotivo' : 'motivo', reglas.requiereMotivo);
        setRequired(esEdicion ? 'editMotivoConstancia' : 'motivoConstancia', reglas.mostrarConstancia);
        setRequired(esEdicion ? 'editDetalleOtro' : 'detalleOtro', reglas.mostrarOtro);

        const labelMotivo = document.getElementById(esEdicion ? 'editLabelMotivo' : 'labelMotivo');
        if (labelMotivo) {
            if (reglas.requiereMotivo) {
                labelMotivo.innerHTML = 'Motivo / Descripción <span class="required">*</span>';
            } else {
                labelMotivo.innerHTML = 'Motivo / Descripción';
            }
        }

        const labelDocumento = document.getElementById(esEdicion ? 'editLabelDocumento' : 'labelDocumento');
        const textoDocumento = document.getElementById(esEdicion ? 'editTextoDocumento' : 'textoDocumento');

        if (labelDocumento && textoDocumento) {
            if (reglas.requiereDocumento) {
                labelDocumento.innerHTML = 'Documento de Respaldo <span class="required">*</span>';
                textoDocumento.textContent = 'Documento obligatorio para este tipo de solicitud';
            } else {
                labelDocumento.innerHTML = 'Documento de Respaldo';
                textoDocumento.textContent = 'Documento opcional si aplica';
            }
        }
    }

    async function cargarTiposSolicitud() {
        try {
            const response = await fetch('/Empleado/ObtenerTiposSolicitud');
            tiposSolicitud = await response.json();

            const tipoSelect = document.getElementById('tipoSolicitud');
            const editTipoSelect = document.getElementById('editTipoSolicitud');
            const filterTipoSelect = document.getElementById('filterTipo');

            tipoSelect.innerHTML = '<option value="">Seleccione un tipo</option>';
            editTipoSelect.innerHTML = '<option value="">Seleccione un tipo</option>';
            filterTipoSelect.innerHTML = '<option value="">Todos</option>';

            tiposSolicitud.forEach(tipo => {
                tipoSelect.innerHTML += `<option value="${tipo.idTipoSolicitud}">${escapeHtml(tipo.nombreSolicitud)}</option>`;
                editTipoSelect.innerHTML += `<option value="${tipo.idTipoSolicitud}">${escapeHtml(tipo.nombreSolicitud)}</option>`;
                filterTipoSelect.innerHTML += `<option value="${normalizarTexto(tipo.nombreSolicitud)}">${escapeHtml(tipo.nombreSolicitud)}</option>`;
            });
        } catch (error) {
            console.error("Error cargando tipos:", error);
            showAlert("Error al cargar los tipos de solicitud", "error");
        }
    }

    async function cargarSolicitudes() {
        try {
            const response = await fetch('/Empleado/SolicitudesEmpleado');
            const data = await response.json();

            if (!Array.isArray(data)) {
                console.log("No autorizado o error");
                return;
            }

            solicitudes = data;
            renderSolicitudes();
            updateCounters();
        } catch (error) {
            console.error("Error cargando solicitudes:", error);
        }
    }

    function obtenerFechaParaFiltro(sol) {
        return sol.fechaInicio || sol.fechaInicioAprobada || sol.fechaSolicitud;
    }

    function renderSolicitudes() {
        const container = document.getElementById('solicitudesList');
        let filtered = [...solicitudes];

        const filterEstado = document.getElementById('filterEstado')?.value;
        const filterTipo = document.getElementById('filterTipo')?.value;
        const filterDesde = document.getElementById('filterDesde')?.value;
        const filterHasta = document.getElementById('filterHasta')?.value;

        if (filterEstado) {
            filtered = filtered.filter(s => s.estado === filterEstado);
        }

        if (filterTipo) {
            filtered = filtered.filter(s => normalizarTexto(s.tipoNombre) === filterTipo);
        }

        if (filterDesde) {
            filtered = filtered.filter(s => obtenerFechaParaFiltro(s) >= filterDesde);
        }

        if (filterHasta) {
            filtered = filtered.filter(s => obtenerFechaParaFiltro(s) <= filterHasta);
        }

        if (filtered.length === 0) {
            container.innerHTML = `
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <h3>No se encontraron solicitudes</h3>
                    <p>No hay solicitudes que coincidan con los filtros</p>
                </div>`;
            document.getElementById('totalBadge').textContent = `0 solicitudes`;
            return;
        }

        const estadoColors = {
            pendiente: '#feebc8',
            aprobada: '#c6f6d5',
            rechazada: '#fed7d7',
            cancelada: '#e2e8f0',
            cancelado: '#e2e8f0'
        };

        filtered.sort((a, b) => new Date(b.fechaSolicitud) - new Date(a.fechaSolicitud));

        container.innerHTML = filtered.map(sol => `
            <div class="request-card ${escapeHtml(sol.estado)}">
                <div class="request-icon" style="background:${estadoColors[sol.estado] || '#e2e8f0'};color:#2d3748;">
                    ${getTipoIcon(sol.tipoNombre)}
                </div>
                <div class="request-info">
                    <div class="request-title">${escapeHtml(sol.tipoNombre)}</div>
                    <div class="request-details">
                        <div class="request-detail-item">
                            📅 ${obtenerTextoRango(sol)}
                        </div>
                        <div class="request-detail-item">${getStatusBadge(sol.estado)}</div>
                        ${sol.diasOtorgados
                            ? `<div class="request-detail-item">🗓️ ${sol.diasOtorgados} día(s) otorgado(s)</div>`
                            : ''}
                        ${sol.nombreArchivo
                            ? `<div class="request-detail-item">📎 1 archivo</div>`
                            : ''}
                    </div>
                </div>
                <div class="request-actions">
                    <button class="btn btn-info" onclick="viewDetail(${sol.id})">Ver</button>
                    ${sol.estado === 'pendiente' ? `
                        <button class="btn btn-success" onclick="editSolicitud(${sol.id})">Editar</button>
                        <button class="btn btn-danger" onclick="cancelSolicitud(${sol.id})">Cancelar</button>
                    ` : ''}
                </div>
            </div>
        `).join('');

        document.getElementById('totalBadge').textContent = `${filtered.length} solicitud(es)`;
    }

    function updateCounters() {
        const pendientes = solicitudes.filter(s => s.estado === 'pendiente').length;
        const aprobadas = solicitudes.filter(s => s.estado === 'aprobada').length;
        const rechazadas = solicitudes.filter(s => s.estado === 'rechazada').length;

        document.getElementById('pendingCount').textContent = pendientes;
        document.getElementById('approvedCount').textContent = aprobadas;
        document.getElementById('rejectedCount').textContent = rechazadas;
        document.getElementById('totalCount').textContent = solicitudes.length;
        document.getElementById('totalBadge').textContent = `${solicitudes.length} solicitudes`;
    }

    function getTipoIcon(tipoNombre) {
        const nombre = normalizarTexto(tipoNombre);
        if (!nombre) return "📄";
        if (nombre.includes("vacacion")) return "🏖️";
        if (nombre.includes("permiso personal")) return "📝";
        if (nombre.includes("fallecimiento")) return "🕊️";
        if (nombre.includes("incapacidad")) return "🏥";
        if (nombre.includes("maternidad")) return "🤱";
        if (nombre.includes("constancia")) return "📑";
        if (nombre.includes("otro")) return "📌";
        return "📄";
    }

    function getStatusBadge(estado) {
        const badges = {
            pendiente: '<span class="badge badge-warning">Pendiente</span>',
            aprobada: '<span class="badge badge-success">Aprobada</span>',
            rechazada: '<span class="badge badge-danger">Rechazada</span>',
            cancelada: '<span class="badge badge-secondary">Cancelada</span>',
            cancelado: '<span class="badge badge-secondary">Cancelado</span>'
        };

        return badges[estado] || '<span class="badge badge-secondary">Sin estado</span>';
    }

    function formatDate(dateStr) {
        if (!dateStr) {
            return 'No definido';
        }

        const date = new Date(dateStr + 'T00:00:00');
        return date.toLocaleDateString('es-CR', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function obtenerTextoRango(sol) {
        if (sol.fechaInicio && sol.fechaFin) {
            return `<strong>${formatDate(sol.fechaInicio)}</strong> al <strong>${formatDate(sol.fechaFin)}</strong>`;
        }

        if (sol.fechaInicioAprobada && sol.fechaFinAprobada) {
            return `<strong>${formatDate(sol.fechaInicioAprobada)}</strong> al <strong>${formatDate(sol.fechaFinAprobada)}</strong>`;
        }

        return '<strong>Fechas por definir por administración</strong>';
    }

    function formatFileSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function showAlert(message, type) {
        const alertDiv = document.getElementById('alertMessage');
        alertDiv.className = `alert alert-${type}`;
        alertDiv.innerHTML = `
            <span style="font-size:18px;">${type === 'success' ? '✅' : type === 'error' ? '❌' : '⚠️'}</span>
            <span>${escapeHtml(message)}</span>
        `;
        alertDiv.style.display = 'flex';
        setTimeout(() => alertDiv.style.display = 'none', 5000);
    }

    function showError(elementId, message) {
        const errorElement = document.getElementById(elementId);
        if (errorElement) {
            errorElement.textContent = message;
            errorElement.parentElement.classList.add('error');
        }
    }

    function clearErrors() {
        document.querySelectorAll('.error-message').forEach(el => el.textContent = '');
        document.querySelectorAll('.form-group').forEach(el => el.classList.remove('error'));
    }

    function switchTab(tabName, element) {
        document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
        element.classList.add('active');
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        document.getElementById(tabName + 'Tab').classList.add('active');

        if (tabName === 'mis') {
            cargarSolicitudes();
        }
    }

    function openModal(modalId) {
        document.getElementById(modalId).classList.add('show');
    }

    function closeModal(modalId) {
        document.getElementById(modalId).classList.remove('show');
    }

    async function handleFormSubmit(event) {
        event.preventDefault();
        clearErrors();

        const tipoId = document.getElementById('tipoSolicitud').value;
        const tipo = obtenerTipoPorId(tipoId);

        if (!tipoId || !tipo) {
            showError('tipoError', 'Campo obligatorio');
            showAlert('Seleccione un tipo de solicitud', 'error');
            return;
        }

        const reglas = obtenerReglasTipo(tipo.nombreSolicitud);

        const prioridad = document.getElementById('prioridad').value;
        const fechaInicio = document.getElementById('fechaInicio').value;
        const fechaFin = document.getElementById('fechaFin').value;
        const motivo = document.getElementById('motivo').value;
        const parentescoFamiliar = document.getElementById('parentescoFamiliar').value;
        const nombreFamiliar = document.getElementById('nombreFamiliar').value;
        const motivoConstancia = document.getElementById('motivoConstancia').value;
        const detalleOtro = document.getElementById('detalleOtro').value;

        let isValid = true;

        if (reglas.requiereFechas) {
            if (!fechaInicio) {
                showError('fechaInicioError', 'Campo obligatorio');
                isValid = false;
            }

            if (!fechaFin) {
                showError('fechaFinError', 'Campo obligatorio');
                isValid = false;
            }

            if (fechaInicio && fechaFin && fechaFin < fechaInicio) {
                showError('fechaFinError', 'La fecha fin no puede ser menor a la fecha inicio');
                isValid = false;
            }
        }

        if (reglas.requiereMotivo && !motivo.trim()) {
            showError('motivoError', 'Campo obligatorio');
            isValid = false;
        }

        if (reglas.mostrarConstancia && !motivoConstancia.trim()) {
            showError('motivoConstanciaError', 'Indique el motivo de la constancia salarial');
            isValid = false;
        }

        if (reglas.mostrarOtro && !detalleOtro.trim()) {
            showError('detalleOtroError', 'Indique el detalle de la solicitud');
            isValid = false;
        }

        if (reglas.requiereDocumento && !uploadedFile) {
            showError('fileError', 'Debe adjuntar un documento de respaldo');
            isValid = false;
        }

        if (!isValid) {
            showAlert('Revise los campos requeridos para este tipo de solicitud', 'error');
            return;
        }

        const formData = new FormData();
        formData.append("IdTipoSolicitud", parseInt(tipoId));
        formData.append("Descripcion", motivo);
        formData.append("Prioridad", prioridad);
        formData.append("ParentescoFamiliar", parentescoFamiliar);
        formData.append("NombreFamiliar", nombreFamiliar);
        formData.append("MotivoConstancia", motivoConstancia);
        formData.append("DetalleOtro", detalleOtro);

        if (reglas.requiereFechas) {
            formData.append("FechaInicio", fechaInicio);
            formData.append("FechaFin", fechaFin);
        }

        if (uploadedFile) {
            formData.append("Archivo", uploadedFile);
        }

        try {
            const response = await fetch('/Empleado/RegistrarSolicitud', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                showAlert(data.message, 'success');
                clearForm();
                await cargarSolicitudes();
            } else {
                showAlert(data.message || 'No se pudo registrar la solicitud', 'error');
            }
        } catch (error) {
            console.error("Error:", error);
            showAlert('Error al registrar la solicitud', 'error');
        }
    }

    function clearForm() {
        document.getElementById('solicitudForm').reset();
        uploadedFile = null;
        renderUploadedFile();
        clearErrors();
        actualizarFormularioPorTipo(false);
    }

    function handleFileSelect(event) {
        const file = event.target.files[0];
        const allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
        const maxSize = 5 * 1024 * 1024;

        document.getElementById('fileError').textContent = '';

        if (!file) {
            return;
        }

        if (!allowedTypes.includes(file.type)) {
            showError('fileError', 'Formato no permitido. Use PDF, JPG o PNG.');
            event.target.value = '';
            return;
        }

        if (file.size > maxSize) {
            showError('fileError', 'Archivo excede 5MB máximo.');
            event.target.value = '';
            return;
        }

        uploadedFile = file;
        renderUploadedFile();
        event.target.value = '';
    }

    function renderUploadedFile() {
        const container = document.getElementById('uploadedFiles');

        if (!uploadedFile) {
            container.innerHTML = '';
            return;
        }

        container.innerHTML = `
            <div class="uploaded-file">
                <div class="file-icon">📄</div>
                <div class="file-info">
                    <div class="file-name">${escapeHtml(uploadedFile.name)}</div>
                    <div class="file-size">${formatFileSize(uploadedFile.size)}</div>
                </div>
                <button type="button" class="file-remove" onclick="removeFile()">🗑️</button>
            </div>
        `;
    }

    function removeFile() {
        uploadedFile = null;
        document.getElementById("fileInput").value = "";
        renderUploadedFile();
    }

    function viewDetail(id) {
        const sol = solicitudes.find(s => s.id === id);
        if (!sol) return;

        document.getElementById('detailContent').innerHTML = `
            <div class="detail-row">
                <div class="detail-label">ID Solicitud</div>
                <div class="detail-value">#${sol.id}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Tipo</div>
                <div class="detail-value">${escapeHtml(sol.tipoNombre)}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Fechas solicitadas</div>
                <div class="detail-value">${sol.fechaInicio && sol.fechaFin ? `${formatDate(sol.fechaInicio)} al ${formatDate(sol.fechaFin)}` : 'No aplica / por definir por administración'}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Fechas aprobadas</div>
                <div class="detail-value">${sol.fechaInicioAprobada && sol.fechaFinAprobada ? `${formatDate(sol.fechaInicioAprobada)} al ${formatDate(sol.fechaFinAprobada)}` : 'Pendiente de definir'}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Días otorgados</div>
                <div class="detail-value">${sol.diasOtorgados ? `${sol.diasOtorgados} día(s)` : 'Pendiente de definir'}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Detalle días</div>
                <div class="detail-value">${sol.diasOtorgadosDetalle ? escapeHtml(sol.diasOtorgadosDetalle) : 'Sin detalle registrado'}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Motivo / Detalle</div>
                <div class="detail-value">${sol.motivo ? escapeHtml(sol.motivo) : 'Sin descripción'}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Estado</div>
                <div class="detail-value">${getStatusBadge(sol.estado)}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Comentario estado</div>
                <div class="detail-value">${sol.descripcionEstado ? escapeHtml(sol.descripcionEstado) : 'Sin comentarios'}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Fecha Solicitud</div>
                <div class="detail-value">${formatDate(sol.fechaSolicitud)}</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Documento</div>
                <div class="detail-value">
                    ${sol.rutaArchivo
                        ? `<a href="${sol.rutaArchivo}" target="_blank" class="btn btn-info">📎 Ver documento</a>`
                        : 'N/A'}
                </div>
            </div>
            <div class="admin-note">
                La cantidad de días otorgados y las fechas finales son definidas por administración según el tipo de solicitud.
            </div>
        `;

        openModal('detailModal');
    }

    function editSolicitud(id) {
        const sol = solicitudes.find(s => s.id === id);

        if (!sol || sol.estado !== 'pendiente') {
            showAlert('No es posible editar solicitudes ya atendidas', 'error');
            return;
        }

        currentEditId = id;

        document.getElementById('editTipoSolicitud').value = sol.tipo;
        document.getElementById('editPrioridad').value = sol.prioridad ?? "normal";
        document.getElementById('editFechaInicio').value = sol.fechaInicio || '';
        document.getElementById('editFechaFin').value = sol.fechaFin || '';
        document.getElementById('editMotivo').value = sol.motivo || '';
        document.getElementById('editParentescoFamiliar').value = '';
        document.getElementById('editNombreFamiliar').value = '';
        document.getElementById('editMotivoConstancia').value = '';
        document.getElementById('editDetalleOtro').value = '';

        editFile = null;
        eliminarArchivo = false;

        const container = document.getElementById("archivoActualContainer");
        archivoActualRuta = sol.rutaArchivo ?? null;

        if (sol.rutaArchivo) {
            container.style.display = "block";
            document.getElementById("archivoActualNombre").textContent = sol.nombreArchivo;
            deshabilitarInputArchivo();
        } else {
            container.style.display = "none";
            habilitarInputArchivo();
        }

        document.getElementById("editUploadedFiles").innerHTML = "";
        actualizarFormularioPorTipo(true);
        openModal('editModal');
    }

    async function handleEditSubmit(event) {
        event.preventDefault();

        const tipoId = document.getElementById('editTipoSolicitud').value;
        const tipo = obtenerTipoPorId(tipoId);

        if (!tipoId || !tipo) {
            showAlert("Seleccione un tipo de solicitud válido", "error");
            return;
        }

        const reglas = obtenerReglasTipo(tipo.nombreSolicitud);

        const fechaInicio = document.getElementById('editFechaInicio').value;
        const fechaFin = document.getElementById('editFechaFin').value;
        const motivo = document.getElementById('editMotivo').value;
        const parentescoFamiliar = document.getElementById('editParentescoFamiliar').value;
        const nombreFamiliar = document.getElementById('editNombreFamiliar').value;
        const motivoConstancia = document.getElementById('editMotivoConstancia').value;
        const detalleOtro = document.getElementById('editDetalleOtro').value;

        if (reglas.requiereFechas && (!fechaInicio || !fechaFin)) {
            showAlert("Debe indicar fecha inicio y fecha fin", "error");
            return;
        }

        if (reglas.requiereFechas && fechaFin < fechaInicio) {
            showAlert("La fecha fin no puede ser menor a la fecha inicio", "error");
            return;
        }

        if (reglas.requiereMotivo && !motivo.trim()) {
            showAlert("Debe indicar el motivo de la solicitud", "error");
            return;
        }

        if (reglas.mostrarConstancia && !motivoConstancia.trim()) {
            showAlert("Debe indicar el motivo de la constancia salarial", "error");
            return;
        }

        if (reglas.mostrarOtro && !detalleOtro.trim()) {
            showAlert("Debe indicar el detalle de la solicitud", "error");
            return;
        }

        if (reglas.requiereDocumento && !archivoActualRuta && !editFile && !eliminarArchivo) {
            showAlert("Este tipo de solicitud requiere documento de respaldo", "error");
            return;
        }

        if (reglas.requiereDocumento && eliminarArchivo && !editFile) {
            showAlert("Debe adjuntar un nuevo documento de respaldo", "error");
            return;
        }

        const formData = new FormData();
        formData.append("IdSolicitud", currentEditId);
        formData.append("IdTipoSolicitud", parseInt(tipoId));
        formData.append("Descripcion", motivo);
        formData.append("Prioridad", document.getElementById('editPrioridad').value);
        formData.append("EliminarArchivo", eliminarArchivo);
        formData.append("ParentescoFamiliar", parentescoFamiliar);
        formData.append("NombreFamiliar", nombreFamiliar);
        formData.append("MotivoConstancia", motivoConstancia);
        formData.append("DetalleOtro", detalleOtro);

        if (reglas.requiereFechas) {
            formData.append("FechaInicio", fechaInicio);
            formData.append("FechaFin", fechaFin);
        }

        if (editFile) {
            formData.append("Archivo", editFile);
        }

        try {
            const response = await fetch('/Empleado/EditarSolicitud', {
                method: 'PUT',
                body: formData
            });

            if (!response.ok) {
                const errorText = await response.text();
                showAlert(errorText || "No se pudo actualizar la solicitud", "error");
                return;
            }

            const data = await response.json();

            if (data.success) {
                showAlert("Solicitud actualizada correctamente", "success");
                closeModal('editModal');
                await cargarSolicitudes();
            } else {
                showAlert(data.message || "No se pudo actualizar la solicitud", "error");
            }
        } catch (error) {
            console.error(error);
            showAlert("Error inesperado", "error");
        }
    }

    function deshabilitarInputArchivo() {
        document.getElementById("editFileInput").disabled = true;
        document.getElementById("editUploadedFiles").innerHTML = `
            <div class="alert alert-warning">
                ⚠️ Debe eliminar el documento actual antes de subir uno nuevo.
            </div>
        `;
    }

    function habilitarInputArchivo() {
        document.getElementById("editFileInput").disabled = false;
        document.getElementById("editUploadedFiles").innerHTML = "";
    }

    function eliminarArchivoActual() {
        eliminarArchivo = true;
        archivoActualRuta = null;
        document.getElementById("archivoActualContainer").style.display = "none";
        habilitarInputArchivo();
    }

    function descargarArchivoActual() {
        if (!archivoActualRuta) return;
        window.open(archivoActualRuta, "_blank");
    }

    function handleEditFileSelect(event) {
        const file = event.target.files[0];

        if (!file) {
            return;
        }

        const allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
        const maxSize = 5 * 1024 * 1024;

        if (!allowedTypes.includes(file.type)) {
            showAlert("Formato no permitido. Use PDF, JPG o PNG.", "error");
            event.target.value = "";
            return;
        }

        if (file.size > maxSize) {
            showAlert("Archivo supera 5MB", "error");
            event.target.value = "";
            return;
        }

        editFile = file;
        eliminarArchivo = false;
        renderEditUploadedFile();
    }

    function renderEditUploadedFile() {
        const container = document.getElementById("editUploadedFiles");

        if (!editFile) {
            container.innerHTML = "";
            return;
        }

        container.innerHTML = `
            <div class="uploaded-file">
                <div class="file-icon">📄</div>
                <div class="file-info">
                    <div class="file-name">${escapeHtml(editFile.name)}</div>
                    <div class="file-size">${formatFileSize(editFile.size)}</div>
                </div>
                <button type="button" class="file-remove" onclick="removeEditFile()">🗑️</button>
            </div>
        `;
    }

    function removeEditFile() {
        editFile = null;
        document.getElementById("editFileInput").value = "";
        renderEditUploadedFile();
    }

    function cancelSolicitud(id) {
        const sol = solicitudes.find(s => s.id === id);

        if (!sol || sol.estado !== 'pendiente') {
            showAlert('Solo se pueden cancelar solicitudes pendientes', 'error');
            return;
        }

        currentCancelId = id;
        openModal('cancelModal');
    }

    async function confirmCancel() {
        try {
            const response = await fetch(`/Empleado/CancelarSolicitud?id=${currentCancelId}`, {
                method: 'PUT',
                credentials: 'same-origin'
            });

            if (!response.ok) {
                console.log(await response.text());
                showAlert("Error al cancelar la solicitud", "error");
                return;
            }

            const data = await response.json();

            if (data.success) {
                showAlert("Solicitud cancelada correctamente", "success");
                closeModal('cancelModal');
                await cargarSolicitudes();
            }
        } catch (error) {
            console.error(error);
            showAlert("Error inesperado", "error");
        }
    }

    function applyFilters() {
        renderSolicitudes();
    }

    function clearFilters() {
        document.getElementById('filterEstado').value = '';
        document.getElementById('filterTipo').value = '';
        document.getElementById('filterDesde').value = '';
        document.getElementById('filterHasta').value = '';
        renderSolicitudes();
    }
</script>