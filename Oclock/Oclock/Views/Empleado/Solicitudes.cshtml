@{
    ViewData["Title"] = "Solicitudes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .main-layout {
        display: flex;
        min-height: 600px;
    }

    .sidebar {
        width: 280px;
        background: #ffffff;
        padding: 30px 20px;
        border-right: 1px solid #e0e0e0;
        box-shadow: 2px 0 10px rgba(0,0,0,0.03);
    }

    .menu-item {
        padding: 0;
        margin: 4px 0;
        border-radius: 10px;
        transition: all 0.3s;
        position: relative;
    }

    .menu-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px 20px;
        color: #4a5568;
        text-decoration: none;
        font-weight: 500;
        font-size: 15px; /* <- Ajuste para igualar fuente */
        border-radius: 10px;
        transition: all 0.3s;
        position: relative;
    }

        .menu-link:hover {
            background: #667eea;
            color: white;
            transform: translateX(5px);
        }

        .menu-link.active {
            background: #667eea;
            color: white;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

            .menu-link.active::before {
                content: '';
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 4px;
                height: 24px;
                background: white;
                border-radius: 0 4px 4px 0;
            }

    .icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .content {
        flex: 1;
        padding: 40px; /* <- Igual al resto */
        background: #f5f7fa;
    }

    .content-header {
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .content-header h1 {
            color: #2d3748;
            font-size: 28px; /* <- Igual que Marcas */
            margin-bottom: 8px;
        }

        .content-header p {
            color: #718096;
            font-size: 14px;
        }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: transform 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .stat-icon {
        font-size: 20px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: bold;
        color: #2d3748;
        margin-bottom: 3px;
    }

    .stat-label {
        color: #718096;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
    }

    /* Tabs */
    .tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        background: white;
        padding: 8px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .tab {
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        color: #4a5568;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
        flex: 1;
        justify-content: center;
    }

        .tab:hover {
            background: #f7fafc;
        }

        .tab.active {
            background: #667eea;
            color: white;
        }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

    /* Form Section */
    .form-section {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }

        .form-section h2 {
            color: #2d3748;
            margin-bottom: 15px;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group label {
            color: #4a5568;
            font-weight: 600;
            font-size: 13px;
        }

            .form-group label .required {
                color: #e53e3e;
                margin-left: 2px;
            }

        .form-group select,
        .form-group input,
        .form-group textarea {
            padding: 10px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            transition: all 0.3s;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

            .form-group select:focus,
            .form-group input:focus,
            .form-group textarea:focus {
                outline: none;
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        .form-group.error input,
        .form-group.error select,
        .form-group.error textarea {
            border-color: #e53e3e;
        }

    .error-message {
        color: #e53e3e;
        font-size: 11px;
        margin-top: 3px;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 80px;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    /* File Upload */
    .file-upload {
        border: 2px dashed #cbd5e0;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
    }

        .file-upload:hover {
            border-color: #667eea;
            background: #f7fafc;
        }

    .file-upload-icon {
        font-size: 32px;
        margin-bottom: 10px;
        opacity: 0.5;
    }

    .file-upload-text {
        color: #4a5568;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .file-upload-hint {
        color: #718096;
        font-size: 11px;
    }

    .file-input {
        display: none;
    }

    .uploaded-files {
        margin-top: 15px;
    }

    .uploaded-file {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: #f7fafc;
        border-radius: 8px;
        margin-bottom: 8px;
    }

    .file-icon {
        font-size: 20px;
    }

    .file-info {
        flex: 1;
    }

    .file-name {
        color: #2d3748;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .file-size {
        color: #718096;
        font-size: 11px;
    }

    .file-remove {
        background: #fed7d7;
        color: #c53030;
        border: none;
        padding: 6px 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 11px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .file-remove:hover {
            background: #fc8181;
            color: white;
        }

    /* Buttons */
    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-primary {
        background: #667eea;
        color: white;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

    .btn-secondary {
        background: #e2e8f0;
        color: #4a5568;
    }

        .btn-secondary:hover {
            background: #cbd5e0;
        }

    .btn-success {
        background: #48bb78;
        color: white;
    }

        .btn-success:hover {
            background: #38a169;
        }

    .btn-danger {
        background: #e53e3e;
        color: white;
    }

        .btn-danger:hover {
            background: #c53030;
        }

    .btn-info {
        background: #667eea;
        color: white;
        padding: 6px 12px;
        font-size: 12px;
    }

        .btn-info:hover {
            background: #5a67d8;
        }

    .btn-group {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* Filter Section */
    .filter-section {
        background: white;
        padding: 15px 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }

        .filter-section h3 {
            color: #2d3748;
            margin-bottom: 12px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        margin-bottom: 12px;
    }

    /* Request Cards */
    .requests-section {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f0f0;
    }

        .section-header h2 {
            color: #2d3748;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .request-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 10px;
        margin-bottom: 12px;
        border-left: 3px solid #667eea;
        transition: all 0.3s;
    }

        .request-card:hover {
            background: #e8edf3;
            transform: translateX(3px);
        }

        .request-card.pendiente {
            border-left-color: #f59e0b;
        }

        .request-card.aprobada {
            border-left-color: #48bb78;
        }

        .request-card.rechazada {
            border-left-color: #e53e3e;
        }

        .request-card.cancelada {
            border-left-color: #718096;
        }

    .request-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .request-info {
        flex: 1;
    }

    .request-title {
        color: #2d3748;
        font-weight: 700;
        margin-bottom: 5px;
        font-size: 14px;
    }

    .request-details {
        color: #718096;
        font-size: 12px;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .request-detail-item {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .request-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* Badges */
    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-warning {
        background: #feebc8;
        color: #7c2d12;
    }

    .badge-success {
        background: #c6f6d5;
        color: #22543d;
    }

    .badge-danger {
        background: #fed7d7;
        color: #742a2a;
    }

    .badge-info {
        background: #bee3f8;
        color: #2c5282;
    }

    .badge-secondary {
        background: #e2e8f0;
        color: #4a5568;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #718096;
    }

    .empty-state-icon {
        font-size: 48px;
        margin-bottom: 15px;
        opacity: 0.5;
    }

    .empty-state h3 {
        color: #4a5568;
        margin-bottom: 8px;
        font-size: 16px;
    }

    .empty-state p {
        font-size: 13px;
    }

    /* Modal */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal.show {
            display: flex;
        }

    .modal-content {
        background: white;
        border-radius: 12px;
        padding: 25px;
        max-width: 600px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f0f0;
    }

        .modal-header h3 {
            color: #2d3748;
            font-size: 18px;
        }

    .btn-close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #718096;
        padding: 0;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.3s;
    }

        .btn-close:hover {
            background: #e2e8f0;
            color: #2d3748;
        }

    .detail-row {
        display: flex;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 700;
        color: #4a5568;
        width: 130px;
        flex-shrink: 0;
        font-size: 13px;
    }

    .detail-value {
        color: #2d3748;
        flex: 1;
        font-size: 13px;
    }

    /* Alert Messages */
    .alert {
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
    }

    .alert-success {
        background: #c6f6d5;
        color: #22543d;
        border-left: 3px solid #48bb78;
    }

    .alert-error {
        background: #fed7d7;
        color: #742a2a;
        border-left: 3px solid #e53e3e;
    }

    .alert-warning {
        background: #feebc8;
        color: #7c2d12;
        border-left: 3px solid #f59e0b;
    }

    .alert-info {
        background: #bee3f8;
        color: #2c5282;
        border-left: 3px solid #4299e1;
    }
</style>

<!-- HTML + JS queda exactamente igual (no toqué nada) -->
<div class="main-layout">
    <div class="sidebar">
        <div class="menu-item">
            <a href="/Home/ColaboradorHome" class="menu-link">
                <div class="icon">⏰</div>
                Marcas
            </a>
        </div>

        <div class="menu-item">
            <a href="/Empleado/HistorialMarcas" class="menu-link">
                <div class="icon">📝</div>
                Mi Historial
            </a>
        </div>

        <div class="menu-item">
            <a href="/Empleado/Solicitudes" class="menu-link active">
                <div class="icon">🗂️</div>
                Mis Solicitudes
            </a>
        </div>
    </div>

    <div class="content">
        <div class="content-header">
            <div>
                <h1>Mis Solicitudes de Permisos</h1>
                <p>Gestiona tus solicitudes de ausencias y permisos</p>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">📌</div>
                </div>
                <div class="stat-value" id="pendingCount"></div>
                <div class="stat-label">Pendientes</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">✅</div>
                </div>
                <div class="stat-value" id="approvedCount"></div>
                <div class="stat-label">Aprobadas</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">❌</div>
                </div>
                <div class="stat-value" id="rejectedCount"></div>
                <div class="stat-label">Rechazadas</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">📊</div>
                </div>
                <div class="stat-value" id="totalCount"></div>
                <div class="stat-label">Total</div>
            </div>
        </div>

        <div class="tabs">
            <div class="tab active" onclick="switchTab('nueva', this)">
                ➕ Nueva Solicitud
            </div>
            <div class="tab" onclick="switchTab('mis', this)">
                📄 Mis Solicitudes
            </div>
        </div>

        <div id="nuevaTab" class="tab-content active">
            <div id="alertMessage" style="display: none;"></div>

            <div class="form-section">
                <h2>📝 Registrar Nueva Solicitud</h2>
                <form id="solicitudForm">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Tipo de Solicitud <span class="required">*</span></label>
                            <select id="tipoSolicitud" required>
                                <option value="">Seleccione un tipo</option>
                                <option value="vacaciones">Vacaciones</option>
                                <option value="permiso">Permiso Personal</option>
                                <option value="incapacidad">Incapacidad</option>
                                <option value="licencia">Licencia</option>
                            </select>
                            <span class="error-message" id="tipoError"></span>
                        </div>

                        <div class="form-group">
                            <label>Prioridad <span class="required">*</span></label>
                            <select id="prioridad" required>
                                <option value="">Seleccione prioridad</option>
                                <option value="normal">Normal</option>
                                <option value="urgente">Urgente</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Fecha Inicio <span class="required">*</span></label>
                            <input type="date" id="fechaInicio" required>
                            <span class="error-message" id="fechaInicioError"></span>
                        </div>

                        <div class="form-group">
                            <label>Fecha Fin <span class="required">*</span></label>
                            <input type="date" id="fechaFin" required>
                            <span class="error-message" id="fechaFinError"></span>
                        </div>

                        <div class="form-group full-width">
                            <label>Motivo / Descripción <span class="required">*</span></label>
                            <textarea id="motivo" placeholder="Describa el motivo de su solicitud..." required></textarea>
                            <span class="error-message" id="motivoError"></span>
                        </div>

                        <div class="form-group full-width">
                            <label>Adjuntar Documentos de Respaldo</label>
                            <div class="file-upload" onclick="document.getElementById('fileInput').click()">
                                <div class="file-upload-icon">📎</div>
                                <div class="file-upload-text">Haz clic para adjuntar archivos</div>
                                <div class="file-upload-hint">PDF, JPG, PNG (Máximo 5MB)</div>
                            </div>
                            <input type="file" id="fileInput" class="file-input" multiple accept=".pdf,.jpg,.jpeg,.png" onchange="handleFileSelect(event)">
                            <span class="error-message" id="fileError"></span>
                            <div id="uploadedFiles" class="uploaded-files"></div>
                        </div>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="btn btn-primary">
                            ✅ Registrar Solicitud
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="clearForm()">
                            🔄 Limpiar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div id="misTab" class="tab-content">
            <div class="filter-section">
                <h3>🔍 Filtrar Solicitudes</h3>
                <div class="filter-grid">
                    <div class="form-group">
                        <label>Estado</label>
                        <select id="filterEstado" onchange="applyFilters()">
                            <option value="">Todos</option>
                            <option value="pendiente">Pendiente</option>
                            <option value="aprobada">Aprobada</option>
                            <option value="rechazada">Rechazada</option>
                            <option value="cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Tipo</label>
                        <select id="filterTipo" onchange="applyFilters()">
                            <option value="">Todos</option>
                            <option value="vacaciones">Vacaciones</option>
                            <option value="permiso">Permiso</option>
                            <option value="incapacidad">Incapacidad</option>
                            <option value="licencia">Licencia</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Desde</label>
                        <input type="date" id="filterDesde" onchange="applyFilters()">
                    </div>
                    <div class="form-group">
                        <label>Hasta</label>
                        <input type="date" id="filterHasta" onchange="applyFilters()">
                    </div>
                </div>
                <button class="btn btn-secondary" onclick="clearFilters()">
                    🔄 Limpiar Filtros
                </button>
            </div>

            <div class="requests-section">
                <div class="section-header">
                    <h2>📄 Mis Solicitudes</h2>
                    <span class="badge badge-info" id="totalBadge">12 solicitudes</span>
                </div>

                <div id="solicitudesList"></div>
            </div>
        </div>
    </div>
</div>

<!-- el resto (modales + script) lo dejaste igual -->