@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>O'Clock - Restablecer contraseña</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            :root {
                --oc-blue: #2F6FED;
                --oc-blue-700: #2457C8;
                --oc-bg: #F6F8FB;
                --oc-surface: #FFFFFF;
                --oc-text: #1F2937;
                --oc-muted: #6B7280;
                --oc-border: #E5E7EB;
                --oc-danger: #E53E3E;
                --oc-radius: 20px;
                --oc-shadow: 0 10px 28px rgba(17, 24, 39, 0.15);
            }

            * {
                box-sizing: border-box;
            }

            body {
                background: var(--oc-bg);
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                font-family: 'Segoe UI', sans-serif;
                padding: 2rem 0;
                color: var(--oc-text);
            }

            .auth-container {
                background: var(--oc-surface);
                width: 520px;
                max-width: 95%;
                border-radius: var(--oc-radius);
                box-shadow: var(--oc-shadow);
                overflow: hidden;
                border: 1px solid var(--oc-border);
                animation: fadeIn 0.35s ease-in-out;
            }

            .brand-bar {
                background: var(--oc-blue);
                color: #fff;
                padding: 14px 18px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .brand-left {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .clock-icon {
                width: 26px;
                height: 26px;
                border: 2px solid #fff;
                border-radius: 50%;
                position: relative;
                flex-shrink: 0;
            }

                .clock-icon::before {
                    content: '';
                    position: absolute;
                    width: 2px;
                    height: 8px;
                    background: #fff;
                    top: 4px;
                    left: 50%;
                    transform: translateX(-50%);
                }

                .clock-icon::after {
                    content: '';
                    position: absolute;
                    width: 2px;
                    height: 6px;
                    background: #fff;
                    top: 9px;
                    left: 50%;
                    transform: translateX(-50%) rotate(90deg);
                    transform-origin: top;
                }

            .brand-title {
                font-weight: 800;
                letter-spacing: .2px;
                font-size: 16px;
                margin: 0;
                line-height: 1;
            }

            .brand-subtitle {
                font-size: 12px;
                opacity: .9;
                margin: 0;
                line-height: 1;
            }

            .brand-right {
                font-size: 12px;
                opacity: .92;
                font-weight: 700;
            }

            .content {
                padding: 2rem;
            }

            .icon-card {
                width: 78px;
                height: 78px;
                border-radius: 22px;
                background: #EEF4FF;
                border: 1px solid rgba(47,111,237,0.18);
                display: flex;
                justify-content: center;
                align-items: center;
                margin: 0 auto 1.2rem auto;
                color: var(--oc-blue);
                font-size: 34px;
            }

            .auth-title {
                color: var(--oc-text);
                font-weight: 800;
                font-size: 1.45rem;
                margin-bottom: 0.5rem;
                text-align: center;
            }

            .auth-description {
                color: var(--oc-muted);
                font-size: 0.95rem;
                line-height: 1.5;
                text-align: center;
                margin-bottom: 1.5rem;
            }

            .form-label {
                color: var(--oc-muted);
                font-weight: 700;
                margin-bottom: 0.35rem;
                font-size: 0.9rem;
            }

            .form-control {
                border-radius: 12px;
                border: 1px solid var(--oc-border);
                padding: 0.65rem 0.85rem;
                font-size: 0.95rem;
            }

                .form-control:focus {
                    border-color: var(--oc-blue);
                    box-shadow: 0 0 0 0.2rem rgba(47, 111, 237, 0.18);
                }

                .form-control.is-invalid {
                    border-color: var(--oc-danger);
                    box-shadow: 0 0 0 0.2rem rgba(229, 62, 62, 0.12);
                }

            .validation-message {
                color: var(--oc-danger);
                font-size: 0.875rem;
                margin-top: 0.25rem;
                font-weight: 700;
                display: block;
            }

            .field-help {
                color: var(--oc-muted);
                font-size: 0.78rem;
                margin-top: 0.2rem;
                display: block;
                line-height: 1.35;
            }

            .password-wrap {
                position: relative;
            }

                .password-wrap .form-control {
                    padding-right: 2.6rem;
                }

            .password-toggle {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: var(--oc-muted);
                cursor: pointer;
                padding: 0;
                line-height: 1;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .password-toggle:hover {
                    color: var(--oc-blue);
                }

                .password-toggle:focus {
                    outline: none;
                }

            .btn-primary-custom {
                background: var(--oc-blue);
                border: none;
                border-radius: 12px;
                padding: 0.7rem 1.2rem;
                font-size: 1rem;
                font-weight: 800;
                color: #fff;
                width: 100%;
                transition: 0.2s;
            }

                .btn-primary-custom:hover {
                    background: var(--oc-blue-700);
                    box-shadow: 0 10px 18px rgba(47,111,237,0.18);
                    transform: translateY(-1px);
                    color: #fff;
                }

                .btn-primary-custom:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                    transform: none;
                    box-shadow: none;
                }

            .btn-secondary-custom {
                background: #e9eef7;
                border: 1px solid var(--oc-border);
                border-radius: 12px;
                padding: 0.7rem 1.2rem;
                font-size: 0.95rem;
                font-weight: 800;
                color: #374151;
                transition: 0.2s;
                text-decoration: none;
                display: inline-block;
                text-align: center;
                width: 100%;
            }

                .btn-secondary-custom:hover {
                    background: #dde6f5;
                    transform: translateY(-1px);
                    color: #374151;
                }

            .alert {
                border-radius: 12px;
                font-weight: 700;
                line-height: 1.5;
            }

            .helper-box {
                background: #F8FAFC;
                border: 1px solid #EEF2F7;
                border-radius: 14px;
                padding: 14px;
                color: var(--oc-muted);
                font-size: 0.85rem;
                line-height: 1.5;
                margin-bottom: 1.2rem;
            }

            .auth-footer {
                padding: 14px 18px;
                border-top: 1px solid var(--oc-border);
                background: #fff;
                font-size: 12px;
                color: var(--oc-muted);
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

                .auth-footer a {
                    color: var(--oc-blue);
                    text-decoration: none;
                    font-weight: 800;
                }

                    .auth-footer a:hover {
                        text-decoration: underline;
                    }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0;
                    align-items: flex-start;
                }

                .content {
                    padding: 1.4rem;
                }

                .brand-right {
                    display: none;
                }

                .auth-footer {
                    flex-direction: column;
                    text-align: center;
                }
            }
    </style>
</head>

<body>
    <div class="auth-container">
        <div class="brand-bar">
            <div class="brand-left">
                <div class="clock-icon"></div>
                <div>
                    <p class="brand-title">O'Clock</p>
                    <p class="brand-subtitle">Sistema de Asistencia</p>
                </div>
            </div>

            <div class="brand-right">
                Recuperación segura
            </div>
        </div>

        <div class="content">
            <div class="icon-card">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h1 class="auth-title">Restablecer contraseña</h1>

            <p class="auth-description">
                Ingrese el código recibido en el correo y defina una nueva contraseña.
            </p>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }
            else if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.ErrorMessage
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }
            else if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success" role="alert">
                    @ViewBag.SuccessMessage
                </div>
            }

            <div id="clientValidationSummary" class="alert alert-danger" style="display:none;"></div>

            <div class="helper-box">
                El código es temporal. La nueva contraseña debe tener al menos 8 caracteres e incluir letras y números.
            </div>

            <form method="post" action="@Url.Action("ResetPassword", "Usuario")" id="resetForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="codigo" class="form-label">Código</label>
                    <input type="text"
                           id="codigo"
                           name="codigo"
                           class="form-control"
                           placeholder="000000"
                           maxlength="6"
                           minlength="6"
                           inputmode="numeric"
                           pattern="[0-9]{6}"
                           autocomplete="one-time-code"
                           required
                           oninput="soloNumerosCodigo(this)" />
                    <span class="validation-message" id="CodigoClientError"></span>
                    <small class="field-help">Digite el código de 6 dígitos enviado a su correo.</small>
                </div>

                <div class="mb-3">
                    <label for="newPass" class="form-label">Nueva contraseña</label>
                    <div class="password-wrap">
                        <input id="newPass"
                               type="password"
                               name="nuevaContrasena"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="new-password"
                               required
                               minlength="8" />
                        <button type="button" class="password-toggle" onclick="togglePassword('newPass', this)" aria-label="Mostrar contraseña">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <span class="validation-message" id="NewPassClientError"></span>
                </div>

                <div class="mb-3">
                    <label for="confirmPass" class="form-label">Confirmar contraseña</label>
                    <div class="password-wrap">
                        <input id="confirmPass"
                               type="password"
                               name="confirmarContrasena"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="new-password"
                               required
                               minlength="8" />
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmPass', this)" aria-label="Mostrar contraseña">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <span class="validation-message" id="ConfirmPassClientError"></span>
                </div>

                <button type="submit" class="btn-primary-custom" id="btnGuardar">
                    <i class="fa-solid fa-floppy-disk me-2"></i>Guardar contraseña
                </button>
            </form>

            <div class="mt-3">
                <a class="btn-secondary-custom" href="@Url.Action("ForgotPassword", "Usuario")">
                    <i class="fa-solid fa-arrow-left me-2"></i>Volver a solicitar código
                </a>
            </div>

            <div class="mt-3">
                <a class="btn-secondary-custom" href="@Url.Action("Index", "Usuario", new { tab = "login" })">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Volver al inicio de sesión
                </a>
            </div>
        </div>

        <div class="auth-footer">
            <span>&copy; @DateTime.Now.Year O'Clock Sistema de Asistencia</span>
            <span>
                <a href="@Url.Action("Privacy", "Home")">Privacidad y uso de datos</a>
            </span>
        </div>
    </div>

    <script>
            function togglePassword(inputId, btn) {
                const input = document.getElementById(inputId);

                if (!input) {
                    return;
                }

                const icon = btn.querySelector('i');
                const isHidden = input.type === 'password';

                input.type = isHidden ? 'text' : 'password';

                if (icon) {
                    icon.classList.toggle('fa-eye', !isHidden);
                    icon.classList.toggle('fa-eye-slash', isHidden);
                }

                btn.setAttribute('aria-label', isHidden ? 'Ocultar contraseña' : 'Mostrar contraseña');
            }

            function soloNumerosCodigo(input) {
                input.value = input.value.replace(/\D/g, '').substring(0, 6);
            }

            function passwordValida(valor) {
                if (!valor || valor.length < 8) {
                    return false;
                }

                const tieneLetra = /[A-Za-zÁÉÍÓÚáéíóúÑñÜü]/.test(valor);
                const tieneNumero = /\d/.test(valor);

                return tieneLetra && tieneNumero;
            }

            function limpiarValidaciones() {
                const summary = document.getElementById('clientValidationSummary');

                if (summary) {
                    summary.style.display = 'none';
                    summary.innerHTML = '';
                }

                document.querySelectorAll('.validation-message').forEach(element => {
                    element.textContent = '';
                });

                document.querySelectorAll('.form-control').forEach(element => {
                    element.classList.remove('is-invalid');
                });
            }

            function marcarError(inputId, errorId, mensaje) {
                const input = document.getElementById(inputId);
                const error = document.getElementById(errorId);

                if (input) {
                    input.classList.add('is-invalid');
                }

                if (error) {
                    error.textContent = mensaje;
                }
            }

            function escapeHtml(valor) {
                if (valor === null || valor === undefined) {
                    return '';
                }

                return valor.toString()
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function mostrarResumenErrores(errores) {
                const summary = document.getElementById('clientValidationSummary');

                if (!summary) {
                    return;
                }

                if (!errores || errores.length === 0) {
                    summary.style.display = 'none';
                    summary.innerHTML = '';
                    return;
                }

                summary.innerHTML = `
                    <strong>Revise los siguientes datos:</strong>
                    <ul class="mb-0 mt-2">
                        ${errores.map(error => `<li>${escapeHtml(error)}</li>`).join('')}
                    </ul>
                `;
                summary.style.display = 'block';
            }

            document.addEventListener('DOMContentLoaded', function () {
                const codigo = document.getElementById('codigo');

                if (codigo) {
                    codigo.addEventListener('paste', function () {
                        setTimeout(() => soloNumerosCodigo(codigo), 0);
                    });
                }

                const form = document.getElementById('resetForm');

                if (!form) {
                    return;
                }

                form.addEventListener('submit', function (event) {
                    limpiarValidaciones();

                    const errores = [];

                    const codigoValor = document.getElementById('codigo')?.value.trim() || '';
                    const nuevaContrasena = document.getElementById('newPass')?.value || '';
                    const confirmarContrasena = document.getElementById('confirmPass')?.value || '';

                    if (!codigoValor) {
                        errores.push('El código es obligatorio.');
                        marcarError('codigo', 'CodigoClientError', 'El código es obligatorio.');
                    } else if (!/^\d{6}$/.test(codigoValor)) {
                        errores.push('El código debe tener exactamente 6 dígitos.');
                        marcarError('codigo', 'CodigoClientError', 'El código debe tener exactamente 6 dígitos.');
                    }

                    if (!nuevaContrasena) {
                        errores.push('La nueva contraseña es obligatoria.');
                        marcarError('newPass', 'NewPassClientError', 'La nueva contraseña es obligatoria.');
                    } else if (!passwordValida(nuevaContrasena)) {
                        errores.push('La contraseña debe tener al menos 8 caracteres e incluir letras y números.');
                        marcarError('newPass', 'NewPassClientError', 'La contraseña debe tener al menos 8 caracteres e incluir letras y números.');
                    }

                    if (!confirmarContrasena) {
                        errores.push('Debe confirmar la contraseña.');
                        marcarError('confirmPass', 'ConfirmPassClientError', 'Debe confirmar la contraseña.');
                    } else if (nuevaContrasena !== confirmarContrasena) {
                        errores.push('Las contraseñas no coinciden.');
                        marcarError('confirmPass', 'ConfirmPassClientError', 'Las contraseñas no coinciden.');
                    }

                    if (errores.length > 0) {
                        event.preventDefault();
                        mostrarResumenErrores(errores);

                        const primerError = document.querySelector('.is-invalid');

                        if (primerError) {
                            primerError.scrollIntoView({
                                behavior: 'smooth',
                                block: 'center'
                            });
                        }

                        return;
                    }

                    const btn = document.getElementById('btnGuardar');

                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Guardando...';
                    }
                });
            });
    </script>
</body>
</html>