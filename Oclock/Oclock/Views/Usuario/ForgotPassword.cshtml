@{
    ViewData["Title"] = "Olvidé la contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>O'Clock - Recuperar contraseña</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            :root {
                --oc-blue: #1565C0;
                --oc-blue-700: #0D47A1;
                --oc-bg: #F5F7FA;
                --oc-surface: #FFFFFF;
                --oc-text: #263238;
                --oc-muted: #78909C;
                --oc-border: #E0E0E0;
                --oc-danger: #D32F2F;
                --oc-radius: 20px;
                --oc-shadow: 0 10px 28px rgba(38, 50, 56, 0.15);
            }

            * {
                box-sizing: border-box;
            }

            body {
                background: var(--oc-bg);
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                font-family: 'Segoe UI', sans-serif;
                padding: 2rem 0;
                color: var(--oc-text);
            }

            .auth-container {
                background: var(--oc-surface);
                width: 520px;
                max-width: 95%;
                border-radius: var(--oc-radius);
                box-shadow: var(--oc-shadow);
                overflow: hidden;
                border: 1px solid var(--oc-border);
                animation: fadeIn 0.35s ease-in-out;
            }

            .brand-bar {
                background: var(--oc-blue);
                color: #FFFFFF;
                padding: 14px 18px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .brand-left {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .clock-icon {
                width: 26px;
                height: 26px;
                border: 2px solid #FFFFFF;
                border-radius: 50%;
                position: relative;
                flex-shrink: 0;
            }

                .clock-icon::before {
                    content: '';
                    position: absolute;
                    width: 2px;
                    height: 8px;
                    background: #FFFFFF;
                    top: 4px;
                    left: 50%;
                    transform: translateX(-50%);
                }

                .clock-icon::after {
                    content: '';
                    position: absolute;
                    width: 2px;
                    height: 6px;
                    background: #FFFFFF;
                    top: 9px;
                    left: 50%;
                    transform: translateX(-50%) rotate(90deg);
                    transform-origin: top;
                }

            .brand-title {
                font-weight: 800;
                letter-spacing: .2px;
                font-size: 16px;
                margin: 0;
                line-height: 1;
            }

            .brand-subtitle {
                font-size: 12px;
                opacity: .9;
                margin: 0;
                line-height: 1;
            }

            .brand-right {
                font-size: 12px;
                opacity: .92;
                font-weight: 700;
            }

            .content {
                padding: 2rem;
            }

            .icon-card {
                width: 78px;
                height: 78px;
                border-radius: 22px;
                background: rgba(21, 101, 192, 0.12);
                border: 1px solid rgba(21, 101, 192,0.18);
                display: flex;
                justify-content: center;
                align-items: center;
                margin: 0 auto 1.2rem auto;
                color: var(--oc-blue);
                font-size: 34px;
            }

            .auth-title {
                color: var(--oc-text);
                font-weight: 800;
                font-size: 1.45rem;
                margin-bottom: 0.5rem;
                text-align: center;
            }

            .auth-description {
                color: var(--oc-muted);
                font-size: 0.95rem;
                line-height: 1.5;
                text-align: center;
                margin-bottom: 1.5rem;
            }

            .form-label {
                color: var(--oc-muted);
                font-weight: 700;
                margin-bottom: 0.35rem;
                font-size: 0.9rem;
            }

            .form-control {
                border-radius: 12px;
                border: 1px solid var(--oc-border);
                padding: 0.65rem 0.85rem;
                font-size: 0.95rem;
            }

                .form-control:focus {
                    border-color: var(--oc-blue);
                    box-shadow: 0 0 0 0.2rem rgba(21, 101, 192, 0.18);
                }

                .form-control.is-invalid {
                    border-color: var(--oc-danger);
                    box-shadow: 0 0 0 0.2rem rgba(211, 47, 47, 0.12);
                }

            .validation-message {
                color: var(--oc-danger);
                font-size: 0.875rem;
                margin-top: 0.25rem;
                font-weight: 700;
                display: block;
            }

            .btn-primary-custom {
                background: var(--oc-blue);
                border: none;
                border-radius: 12px;
                padding: 0.7rem 1.2rem;
                font-size: 1rem;
                font-weight: 800;
                color: #FFFFFF;
                width: 100%;
                transition: 0.2s;
            }

                .btn-primary-custom:hover {
                    background: var(--oc-blue-700);
                    box-shadow: 0 10px 18px rgba(21, 101, 192,0.18);
                    transform: translateY(-1px);
                    color: #FFFFFF;
                }

                .btn-primary-custom:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                    transform: none;
                    box-shadow: none;
                }

            .btn-secondary-custom {
                background: rgba(21, 101, 192, 0.08);
                border: 1px solid var(--oc-border);
                border-radius: 12px;
                padding: 0.7rem 1.2rem;
                font-size: 0.95rem;
                font-weight: 800;
                color: #455A64;
                transition: 0.2s;
                text-decoration: none;
                display: inline-block;
                text-align: center;
                width: 100%;
            }

                .btn-secondary-custom:hover {
                    background: rgba(21, 101, 192, 0.08);
                    transform: translateY(-1px);
                    color: #455A64;
                }

            .alert {
                border-radius: 12px;
                font-weight: 700;
                line-height: 1.5;
            }

            .helper-box {
                background: #F5F7FA;
                border: 1px solid #F5F7FA;
                border-radius: 14px;
                padding: 14px;
                color: var(--oc-muted);
                font-size: 0.85rem;
                line-height: 1.5;
                margin-bottom: 1.2rem;
            }

            .auth-footer {
                padding: 14px 18px;
                border-top: 1px solid var(--oc-border);
                background: #FFFFFF;
                font-size: 12px;
                color: var(--oc-muted);
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

                .auth-footer a {
                    color: var(--oc-blue);
                    text-decoration: none;
                    font-weight: 800;
                }

                    .auth-footer a:hover {
                        text-decoration: underline;
                    }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0;
                    align-items: flex-start;
                }

                .content {
                    padding: 1.4rem;
                }

                .brand-right {
                    display: none;
                }

                .auth-footer {
                    flex-direction: column;
                    text-align: center;
                }
            }
    
</style>
</head>

<body>
    <div class="auth-container">
        <div class="brand-bar">
            <div class="brand-left">
                <div class="clock-icon"></div>
                <div>
                    <p class="brand-title">O'Clock</p>
                    <p class="brand-subtitle">Sistema de Asistencia</p>
                </div>
            </div>

            <div class="brand-right">
                Recuperación segura
            </div>
        </div>

        <div class="content">
            <div class="icon-card">
                <i class="fa-solid fa-key"></i>
            </div>

            <h1 class="auth-title">Recuperar contraseña</h1>

            <p class="auth-description">
                Ingrese su correo electrónico y le enviaremos un código para restablecer la contraseña.
            </p>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }
            else if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.ErrorMessage
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }
            else if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success" role="alert">
                    @ViewBag.SuccessMessage
                </div>
            }

            <div id="clientValidationSummary" class="alert alert-danger" style="display:none;"></div>

            <div class="helper-box">
                Por seguridad, si el correo existe en el sistema, se enviará un código temporal de recuperación.
            </div>

            <form method="post" action="@Url.Action("ForgotPassword", "Usuario")" id="forgotForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="form-control"
                           placeholder="usuario@empresa.com"
                           autocomplete="email"
                           maxlength="100"
                           required />
                    <span class="validation-message" id="EmailClientError"></span>
                </div>

                <button type="submit" class="btn-primary-custom" id="btnEnviarCodigo">
                    <i class="fa-solid fa-paper-plane me-2"></i>Enviar código
                </button>
            </form>

            <div class="mt-3">
                <a class="btn-secondary-custom" href="@Url.Action("Index", "Usuario", new { tab = "login" })">
                    <i class="fa-solid fa-arrow-left me-2"></i>Volver al inicio de sesión
                </a>
            </div>
        </div>

        <div class="auth-footer">
            <span>&copy; @DateTime.Now.Year O'Clock Sistema de Asistencia</span>
            <span>
                <a href="@Url.Action("Privacy", "Home")">Privacidad y uso de datos</a>
            </span>
        </div>
    </div>

    <script>
            function emailValido(valor) {
                return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(valor);
            }

            function limpiarValidaciones() {
                const summary = document.getElementById('clientValidationSummary');
                const email = document.getElementById('email');
                const emailError = document.getElementById('EmailClientError');

                if (summary) {
                    summary.style.display = 'none';
                    summary.textContent = '';
                }

                if (email) {
                    email.classList.remove('is-invalid');
                }

                if (emailError) {
                    emailError.textContent = '';
                }
            }

            function mostrarError(mensaje) {
                const summary = document.getElementById('clientValidationSummary');
                const email = document.getElementById('email');
                const emailError = document.getElementById('EmailClientError');

                if (summary) {
                    summary.textContent = mensaje;
                    summary.style.display = 'block';
                }

                if (email) {
                    email.classList.add('is-invalid');
                }

                if (emailError) {
                    emailError.textContent = mensaje;
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('forgotForm');

                if (!form) {
                    return;
                }

                form.addEventListener('submit', function (event) {
                    limpiarValidaciones();

                    const email = document.getElementById('email')?.value.trim() || '';

                    if (!email) {
                        event.preventDefault();
                        mostrarError('Debe ingresar un correo electrónico.');
                        return;
                    }

                    if (!emailValido(email)) {
                        event.preventDefault();
                        mostrarError('Ingrese un correo electrónico válido.');
                        return;
                    }

                    const btn = document.getElementById('btnEnviarCodigo');

                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Enviando código...';
                    }
                });
            });
    </script>
</body>
</html>