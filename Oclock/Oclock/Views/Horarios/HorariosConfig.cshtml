    <div class="content">
        <div class="content-header fade-in">
            <h1>⏰ Configuración de Horarios</h1>
            <p>Gestione horarios laborales y asigne colaboradores a cada turno.</p>
        </div>

        <div id="messageBox" class="message-box"></div>

        @if (TempData["Exito"] != null)
        {
            <div class="alert-ok fade-in">✅ @TempData["Exito"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-err fade-in">❌ @TempData["Error"]</div>
        }

        <div class="stats-row fade-in">
            <div class="stat-mini">
                <div class="stat-mini-value">@horarios.Count</div>
                <div class="stat-mini-label">Horarios configurados</div>
            </div>

            <div class="stat-mini">
                <div class="stat-mini-value">@totalAsignados</div>
                <div class="stat-mini-label">Colaboradores asignados</div>
            </div>

            <div class="stat-mini">
                <div class="stat-mini-value">@usuarios.Count</div>
                <div class="stat-mini-label">Colaboradores activos</div>
            </div>
        </div>

        <div class="config-card fade-in">
            <div class="card-header-custom">
                <h2>➕ Nuevo horario</h2>
                <span class="badge-custom">Configuración</span>
            </div>

            <div class="card-body-custom">
                <p class="helper-text">
                    Cree un horario laboral indicando nombre, hora de entrada, hora de salida y días laborales.
                </p>

                <form method="post" action="/Horarios/CrearHorario" id="formCrearHorario" onsubmit="return validarFormularioHorario(this, 'crear')">
                    @Html.AntiForgeryToken()

                    <div class="form-group-full">
                        <label class="form-label" for="crearNombreHorario">📝 Nombre del horario</label>
                        <input type="text"
                               id="crearNombreHorario"
                               name="nombreHorario"
                               class="form-control"
                               placeholder="Ejemplo: Turno mañana, Horario estándar"
                               maxlength="100"
                               required>
                        <span class="field-error" id="crearNombreError"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="crearHoraEntrada">🟢 Hora de entrada</label>
                            <input type="time"
                                   id="crearHoraEntrada"
                                   name="horaEntrada"
                                   class="form-control"
                                   value="08:00"
                                   required>
                            <span class="field-error" id="crearEntradaError"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="crearHoraSalida">🔴 Hora de salida</label>
                            <input type="time"
                                   id="crearHoraSalida"
                                   name="horaSalida"
                                   class="form-control"
                                   value="17:00"
                                   required>
                            <span class="field-error" id="crearSalidaError"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="crearDias">📅 Días laborales</label>
                            <select id="crearDias" name="dias" class="form-select">
                                <option value="Lunes a Viernes">Lunes a Viernes</option>
                                <option value="Lunes a Sábado">Lunes a Sábado</option>
                                <option value="Lunes a Domingo">Lunes a Domingo</option>
                                <option value="Personalizado">Personalizado</option>
                            </select>
                        </div>
                    </div>

                    <div class="btn-actions">
                        <button type="submit" class="btn-primary-custom">
                            💾 Crear horario
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="config-card fade-in">
            <div class="card-header-custom">
                <h2>📋 Horarios configurados</h2>
                <span class="badge-custom">@horarios.Count registro(s)</span>
            </div>

            <div class="card-body-custom" style="padding:0">
                @if (!horarios.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">⏰</div>
                        <h3>No hay horarios configurados</h3>
                        <p>Cree el primer horario desde el formulario superior.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Entrada</th>
                                    <th>Salida</th>
                                    <th>Horas/día</th>
                                    <th>Días</th>
                                    <th>Colaboradores</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var h in horarios)
                                {
                                    var horas = (h.HoraSalida - h.HoraEntrada).TotalHours;

                                    if (horas < 0)
                                    {
                                        horas += 24;
                                    }

                                    var nombreHorario = h.NombreHorario ?? "Horario sin nombre";

                                    <tr>
                                        <td><strong>@nombreHorario</strong></td>
                                        <td><span class="badge-time">@h.HoraEntrada.ToString("hh:mm tt")</span></td>
                                        <td><span class="badge-time">@h.HoraSalida.ToString("hh:mm tt")</span></td>
                                        <td><span class="badge-time">@horas.ToString("F1")h</span></td>
                                        <td><span class="badge-dias">@(h.Dias ?? "—")</span></td>
                                        <td>
                                            <a href="/Horarios/HorariosConfig?asignarId=@h.IdHorario"
                                               class="badge-count">
                                                👥 @h.UsuarioHorarios.Count
                                            </a>
                                        </td>
                                        <td style="white-space:nowrap">
                                            <a href="/Horarios/HorariosConfig?editarId=@h.IdHorario"
                                               class="btn-icon btn-edit"
                                               title="Editar horario">
                                                ✏️
                                            </a>

                                            <a href="/Horarios/HorariosConfig?asignarId=@h.IdHorario"
                                               class="btn-icon btn-assign"
                                               title="Asignar colaboradores">
                                                👥
                                            </a>

                                            <form method="post"
                                                  action="/Horarios/EliminarHorario"
                                                  class="form-eliminar-horario"
                                                  data-nombre="@nombreHorario"
                                                  style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idHorario" value="@h.IdHorario" />
                                                <button type="submit" class="btn-icon btn-del" title="Eliminar horario">
                                                    🗑️
                                                </button>
                                            </form>
                                        </td>
                                    </tr>

                                    @if (h.UsuarioHorarios.Any())
                                    {
                                        <tr style="background:#F5F7FA">
                                            <td colspan="7" style="padding:0">
                                                <div class="chips-row">
                                                    @foreach (var uh in h.UsuarioHorarios)
                                                    {
                                                        var nombreUsuario = ((uh.IdUsuarioNavigation?.Nombre ?? "") + " " + (uh.IdUsuarioNavigation?.Apellido ?? "")).Trim();

                                                        if (string.IsNullOrWhiteSpace(nombreUsuario))
                                                        {
                                                            nombreUsuario = "Usuario no disponible";
                                                        }

                                                        <span class="chip">
                                                            👤 @nombreUsuario

                                                            <form method="post"
                                                                  action="/Horarios/DesasignarUsuario"
                                                                  class="form-desasignar-usuario"
                                                                  data-nombre="@nombreUsuario"
                                                                  style="display:inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="idHorario" value="@h.IdHorario" />
                                                                <input type="hidden" name="idUsuario" value="@uh.IdUsuario" />
                                                                <button type="submit" class="chip-btn" title="Desasignar colaborador">
                                                                    ✕
                                                                </button>
                                                            </form>
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay @(editarId.HasValue ? "open" : "")" id="modalEditarHorario">
    <div class="modal-box">
        <div class="modal-head">
            <h3>✏️ Editar horario</h3>
            <a href="/Horarios/HorariosConfig" class="modal-close">✕</a>
        </div>

        @if (horarioEditando != null)
        {
            <form method="post" action="/Horarios/EditarHorario" id="formEditarHorario" onsubmit="return validarFormularioHorario(this, 'editar')">
                @Html.AntiForgeryToken()

                <input type="hidden" name="idHorario" value="@horarioEditando.IdHorario" />

                <div class="modal-body">
                    <div class="modal-error" id="editarModalError"></div>

                    <div class="form-group-full">
                        <label class="form-label" for="editarNombreHorario">📝 Nombre del horario</label>
                        <input type="text"
                               id="editarNombreHorario"
                               name="nombreHorario"
                               class="form-control"
                               value="@horarioEditando.NombreHorario"
                               maxlength="100"
                               required>
                        <span class="field-error" id="editarNombreError"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="editarHoraEntrada">🟢 Hora de entrada</label>
                            <input type="time"
                                   id="editarHoraEntrada"
                                   name="horaEntrada"
                                   class="form-control"
                                   value="@horarioEditando.HoraEntrada.ToString("HH:mm")"
                                   required>
                            <span class="field-error" id="editarEntradaError"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="editarHoraSalida">🔴 Hora de salida</label>
                            <input type="time"
                                   id="editarHoraSalida"
                                   name="horaSalida"
                                   class="form-control"
                                   value="@horarioEditando.HoraSalida.ToString("HH:mm")"
                                   required>
                            <span class="field-error" id="editarSalidaError"></span>
                        </div>
                    </div>

                    <div class="form-group-full">
                        <label class="form-label" for="editarDias">📅 Días laborales</label>

                        @{
                            var diasVal = horarioEditando.Dias ?? "";
                            var opcionesDias = new[] { "Lunes a Viernes", "Lunes a Sábado", "Lunes a Domingo", "Personalizado" };
                        }

                        <select id="editarDias" name="dias" class="form-select">
                            @foreach (var op in opcionesDias)
                            {
                                var seleccionado = diasVal == op || (diasVal == "Lunes a Sabado" && op == "Lunes a Sábado");

                                if (seleccionado)
                                {
                                    <option value="@op" selected="selected">@op</option>
                                }
                                else
                                {
                                    <option value="@op">@op</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="modal-foot">
                    <a href="/Horarios/HorariosConfig" class="btn-outline-custom">
                        Cancelar
                    </a>

                    <button type="submit" class="btn-primary-custom">
                        💾 Guardar cambios
                    </button>
                </div>
            </form>
        }
    </div>
</div>

<div class="modal-overlay @(asignarId.HasValue ? "open" : "")" id="modalAsignarHorario">
    <div class="modal-box modal-box-lg">
        <div class="modal-head">
            <h3>👥 Asignar colaboradores — @(horarioAsignando?.NombreHorario ?? "")</h3>
            <a href="/Horarios/HorariosConfig" class="modal-close">✕</a>
        </div>

        @if (horarioAsignando != null)
        {
            <form method="post" action="/Horarios/AsignarUsuarios">
                @Html.AntiForgeryToken()

                <input type="hidden" name="idHorario" value="@horarioAsignando.IdHorario" />

                <div class="modal-body">
                    <div class="sel-count" id="selCount">
                        @yaAsignados.Count colaborador(es) actualmente asignado(s)
                    </div>

                    <div class="user-filter">
                        <span class="user-filter-icon">🔍</span>
                        <input type="text"
                               class="form-control"
                               placeholder="Buscar colaborador..."
                               oninput="filtrarUsuarios(this.value)">
                    </div>

                    <div class="user-list">
                        @foreach (var u in usuarios)
                        {
                            var nombre = (u.Nombre ?? "").Trim();
                            var apellido = (u.Apellido ?? "").Trim();
                            var nombreCompleto = (nombre + " " + apellido).Trim();

                            if (string.IsNullOrWhiteSpace(nombreCompleto))
                            {
                                nombreCompleto = "Usuario sin nombre";
                            }

                            var inicialNombre = !string.IsNullOrWhiteSpace(nombre) ? nombre[0].ToString() : "U";
                            var inicialApellido = !string.IsNullOrWhiteSpace(apellido) ? apellido[0].ToString() : "";
                            var iniciales = (inicialNombre + inicialApellido).ToUpper();

                            var marcado = yaAsignados.Contains(u.IdUsuario);

                            <label class="user-row @(marcado ? "checked" : "")" for="chk-@u.IdUsuario">
                                <div class="user-avatar">@iniciales</div>

                                <div class="user-info">
                                    <div class="user-name">@nombreCompleto</div>
                                    <div class="user-sub">Colaborador activo</div>
                                </div>

                                <input type="checkbox"
                                       class="user-cb emp-cb"
                                       id="chk-@u.IdUsuario"
                                       name="idsUsuarios"
                                       value="@u.IdUsuario"
                                @(marcado ? "checked" : "")
                                       onchange="actualizarContador()" />
                            </label>
                        }

                        @if (!usuarios.Any())
                        {
                            <div class="empty-state">
                                <div class="empty-icon">👤</div>
                                <h3>No hay colaboradores activos</h3>
                                <p>No hay usuarios disponibles para asignar a este horario.</p>
                            </div>
                        }
                    </div>

                    <div class="alert-info">
                        ℹ️ Al guardar, las asignaciones seleccionadas reemplazarán las asignaciones actuales de este horario.
                    </div>
                </div>

                <div class="modal-foot">
                    <a href="/Horarios/HorariosConfig" class="btn-outline-custom">
                        Cancelar
                    </a>

                    <button type="submit" class="btn-primary-custom">
                        💾 Guardar asignaciones
                    </button>
                </div>
            </form>
        }
    </div>
</div>

<script>
    function toggleSubmenu(element) {
        const submenu = element.querySelector('.submenu');
        const header = element.querySelector('.menu-expandable-header');

        element.classList.toggle('expanded');
        submenu.classList.toggle('show');

        if (element.classList.contains('expanded')) {
            header.classList.add('active');
        } else {
            header.classList.remove('active');
        }
    }

    function mostrarMensaje(mensaje, tipo) {
        const box = document.getElementById('messageBox');

        if (!box) {
            return;
        }

        box.className = 'message-box';

        if (tipo === 'success') {
            box.classList.add('message-success');
        } else if (tipo === 'error') {
            box.classList.add('message-error');
        } else {
            box.classList.add('message-info');
        }

        box.textContent = mensaje;
        box.style.display = 'block';

        setTimeout(() => {
            box.style.display = 'none';
        }, 5000);
    }

    function limpiarErrorCampo(input, span) {
        if (input) {
            input.classList.remove('input-error');
        }

        if (span) {
            span.textContent = '';
            span.classList.remove('show');
        }
    }

    function marcarErrorCampo(input, span, mensaje) {
        if (input) {
            input.classList.add('input-error');
        }

        if (span) {
            span.textContent = mensaje;
            span.classList.add('show');
        }
    }

    function mostrarErrorModal(id, mensaje) {
        const modalError = document.getElementById(id);

        if (!modalError) {
            return;
        }

        modalError.textContent = mensaje;
        modalError.style.display = 'block';
    }

    function ocultarErrorModal(id) {
        const modalError = document.getElementById(id);

        if (!modalError) {
            return;
        }

        modalError.textContent = '';
        modalError.style.display = 'none';
    }

    function validarFormularioHorario(form, modo) {
        const prefijo = modo === 'editar' ? 'editar' : 'crear';

        const nombre = document.getElementById(`${prefijo}NombreHorario`);
        const entrada = document.getElementById(`${prefijo}HoraEntrada`);
        const salida = document.getElementById(`${prefijo}HoraSalida`);

        const nombreError = document.getElementById(`${prefijo}NombreError`);
        const entradaError = document.getElementById(`${prefijo}EntradaError`);
        const salidaError = document.getElementById(`${prefijo}SalidaError`);

        limpiarErrorCampo(nombre, nombreError);
        limpiarErrorCampo(entrada, entradaError);
        limpiarErrorCampo(salida, salidaError);

        if (modo === 'editar') {
            ocultarErrorModal('editarModalError');
        }

        let valido = true;
        let primerMensaje = '';

        if (!nombre.value.trim()) {
            marcarErrorCampo(nombre, nombreError, 'El nombre del horario es obligatorio.');
            primerMensaje = primerMensaje || 'El nombre del horario es obligatorio.';
            valido = false;
        } else if (nombre.value.trim().length > 100) {
            marcarErrorCampo(nombre, nombreError, 'El nombre no puede superar los 100 caracteres.');
            primerMensaje = primerMensaje || 'El nombre no puede superar los 100 caracteres.';
            valido = false;
        }

        if (!entrada.value) {
            marcarErrorCampo(entrada, entradaError, 'La hora de entrada es obligatoria.');
            primerMensaje = primerMensaje || 'La hora de entrada es obligatoria.';
            valido = false;
        }

        if (!salida.value) {
            marcarErrorCampo(salida, salidaError, 'La hora de salida es obligatoria.');
            primerMensaje = primerMensaje || 'La hora de salida es obligatoria.';
            valido = false;
        }

        if (entrada.value && salida.value && entrada.value === salida.value) {
            marcarErrorCampo(salida, salidaError, 'La hora de salida no puede ser igual a la hora de entrada.');
            primerMensaje = primerMensaje || 'La hora de salida no puede ser igual a la hora de entrada.';
            valido = false;
        }

        if (!valido) {
            if (modo === 'editar') {
                mostrarErrorModal('editarModalError', primerMensaje || 'Revise los datos del horario.');
            } else {
                mostrarMensaje(primerMensaje || 'Revise los datos del horario.', 'error');
            }

            return false;
        }

        return true;
    }

    function filtrarUsuarios(valor) {
        const q = (valor || '').toLowerCase();

        document.querySelectorAll('.user-row').forEach(row => {
            const name = row.querySelector('.user-name')?.textContent.toLowerCase() || '';
            row.style.display = name.includes(q) ? 'flex' : 'none';
        });
    }

    function actualizarContador() {
        const checks = document.querySelectorAll('.emp-cb');
        let total = 0;

        checks.forEach(cb => {
            const row = cb.closest('.user-row');

            if (row) {
                row.classList.toggle('checked', cb.checked);
            }

            if (cb.checked) {
                total++;
            }
        });

        const el = document.getElementById('selCount');

        if (el) {
            el.textContent = total === 1
                ? '1 colaborador seleccionado'
                : `${total} colaboradores seleccionados`;
        }
    }

    document.querySelectorAll('.form-eliminar-horario').forEach(form => {
        form.addEventListener('submit', function (event) {
            const nombre = this.dataset.nombre || 'este horario';

            if (!confirm(`¿Desea eliminar ${nombre}? Esta acción no se puede deshacer.`)) {
                event.preventDefault();
            }
        });
    });

    document.querySelectorAll('.form-desasignar-usuario').forEach(form => {
        form.addEventListener('submit', function (event) {
            const nombre = this.dataset.nombre || 'este colaborador';

            if (!confirm(`¿Desea desasignar a ${nombre} de este horario?`)) {
                event.preventDefault();
            }
        });
    });

    document.addEventListener('DOMContentLoaded', actualizarContador);
</script>