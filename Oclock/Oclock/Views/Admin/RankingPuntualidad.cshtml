@{
    ViewData["Title"] = "Ranking de Puntualidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .main-layout {
        display: flex;
        min-height: 600px;
    }

    /* SIDEBAR */
    .sidebar {
        width: 280px;
        background: #ffffff;
        padding: 30px 20px;
        border-right: 1px solid #e0e0e0;
        box-shadow: 2px 0 10px rgba(0,0,0,0.03);
    }

    .menu-item {
        padding: 0;
        margin: 4px 0;
        border-radius: 10px;
        transition: all 0.3s;
        position: relative;
    }

    .menu-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px 20px;
        color: #4a5568;
        text-decoration: none;
        font-weight: 500;
        border-radius: 10px;
        transition: all 0.3s;
        position: relative;
    }

        .menu-link:hover {
            background: #667eea;
            color: white;
            transform: translateX(5px);
        }

        .menu-link.active {
            background: #667eea;
            color: white;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

            .menu-link.active::before {
                content: '';
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 4px;
                height: 24px;
                background: white;
                border-radius: 0 4px 4px 0;
            }

    .icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    /* Menu Expandible */
    .menu-expandable {
        cursor: pointer;
    }

    .menu-expandable-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 20px;
        color: #4a5568;
        font-weight: 500;
        border-radius: 10px;
        transition: all 0.3s;
    }

        .menu-expandable-header:hover {
            background: #f0f0f0;
            color: #667eea;
        }

        .menu-expandable-header.active {
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
            font-weight: 600;
        }

    .menu-expandable-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .menu-arrow {
        font-size: 12px;
        transition: transform 0.3s;
    }

    .menu-expandable.expanded .menu-arrow {
        transform: rotate(90deg);
    }

    .submenu {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out;
        margin-left: 20px;
        margin-top: 4px;
    }

        .submenu.show {
            max-height: 500px;
            transition: max-height 0.5s ease-in;
        }

    .submenu-item {
        margin: 4px 0;
    }

    .submenu-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        padding-left: 40px;
        color: #718096;
        text-decoration: none;
        font-weight: 500;
        font-size: 14px;
        border-radius: 8px;
        transition: all 0.3s;
        position: relative;
    }

        .submenu-link::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 6px;
            height: 6px;
            background: #cbd5e0;
            border-radius: 50%;
            transition: all 0.3s;
        }

        .submenu-link:hover {
            background: #f7fafc;
            color: #667eea;
            transform: translateX(3px);
        }

            .submenu-link:hover::before {
                background: #667eea;
                transform: translateY(-50%) scale(1.3);
            }

        .submenu-link.active {
            background: rgba(102, 126, 234, 0.15);
            color: #667eea;
            font-weight: 600;
        }

            .submenu-link.active::before {
                background: #667eea;
                width: 8px;
                height: 8px;
            }
    .content {
        flex: 1;
        padding: 40px;
        background: #f5f7fa;
    }

    .content-header {
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 16px;
    }

        .content-header h1 {
            color: #2d3748;
            font-size: 28px;
            margin-bottom: 8px;
        }

        .content-header p {
            color: #718096;
            font-size: 14px;
        }

    /* Period selector */
    .period-selector {
        display: flex;
        align-items: center;
        gap: 10px;
        background: white;
        padding: 10px 16px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

        .period-selector label {
            font-size: 13px;
            font-weight: 600;
            color: #4a5568;
        }

        .period-selector select {
            padding: 8px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s;
        }

            .period-selector select:focus {
                border-color: #2F6FED;
            }

    /* Stats */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 15px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        padding: 18px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: transform 0.3s;
        border-left: 4px solid #2F6FED;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

        .stat-card.green {
            border-left-color: #48bb78;
        }

        .stat-card.red {
            border-left-color: #e53e3e;
        }

        .stat-card.yellow {
            border-left-color: #f59e0b;
        }

    .stat-icon {
        font-size: 22px;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 26px;
        font-weight: bold;
        color: #2d3748;
        margin-bottom: 4px;
    }

    .stat-label {
        color: #718096;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
    }

    /* Table section */
    .table-section {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f0f0;
        flex-wrap: wrap;
        gap: 10px;
    }

        .section-header h2 {
            color: #2d3748;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    /* Search */
    .search-box {
        padding: 8px 14px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 13px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        outline: none;
        transition: border-color 0.2s;
        width: 220px;
    }

        .search-box:focus {
            border-color: #2F6FED;
        }

    /* Table */
    .ranking-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .ranking-table thead tr {
            background: #f8faff;
        }

        .ranking-table th {
            padding: 12px 14px;
            text-align: left;
            font-weight: 700;
            color: #4a5568;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #e2e8f0;
            cursor: pointer;
            user-select: none;
            white-space: nowrap;
        }

            .ranking-table th:hover {
                color: #2F6FED;
            }

            .ranking-table th .sort-icon {
                margin-left: 4px;
                opacity: 0.4;
                font-size: 10px;
            }

            .ranking-table th.sorted .sort-icon {
                opacity: 1;
                color: #2F6FED;
            }

        .ranking-table tbody tr {
            border-bottom: 1px solid #f0f0f0;
            transition: background 0.15s;
        }

            .ranking-table tbody tr:hover {
                background: #f7f9ff;
            }

            .ranking-table tbody tr:last-child {
                border-bottom: none;
            }

        .ranking-table td {
            padding: 13px 14px;
            color: #2d3748;
            vertical-align: middle;
        }

    .empleado-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #EBF2FF;
        color: #2F6FED;
        font-weight: 700;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .empleado-name {
        font-weight: 600;
        color: #2d3748;
    }

    /* Progress bar */
    .progress-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 160px;
    }

    .progress-bar-bg {
        flex: 1;
        height: 8px;
        background: #e2e8f0;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.6s ease;
    }

    .progress-label {
        font-weight: 700;
        font-size: 13px;
        min-width: 42px;
        text-align: right;
    }

    /* Badges */
    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-success {
        background: #c6f6d5;
        color: #22543d;
    }

    .badge-warning {
        background: #feebc8;
        color: #7c2d12;
    }

    .badge-danger {
        background: #fed7d7;
        color: #742a2a;
    }

    .badge-info {
        background: #bee3f8;
        color: #2c5282;
    }

    /* hora promedio */
    .hora-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        color: #4a5568;
    }

    /* Empty / loading */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #718096;
    }

    .empty-state-icon {
        font-size: 48px;
        margin-bottom: 15px;
        opacity: 0.5;
    }

    .empty-state h3 {
        color: #4a5568;
        margin-bottom: 8px;
        font-size: 16px;
    }

    .empty-state p {
        font-size: 13px;
    }

    /* Responsive overflow */
    .table-wrapper {
        overflow-x: auto;
    }
</style>

<div class="main-layout">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="menu-item">
            <a href="/Home/AdminHome" class="menu-link">
                <div class="icon">📊</div>
                Dashboard
            </a>
        </div>

        <div class="menu-item">
            <a href="/Admin/VerMarcas" class="menu-link">
                <div class="icon">⏰</div>
                Marcas de Asistencia
            </a>
        </div>

        <div class="menu-item menu-expandable expanded" onclick="toggleSubmenu(this)">
            <div class="menu-expandable-header">
                <div class="menu-expandable-left">
                    <div class="icon">⚙️</div>
                    <span>Configuración y Políticas</span>
                </div>
                <div class="menu-arrow">▶</div>
            </div>
            <div class="submenu show">
                <div class="submenu-item"><a href="/Horarios/HorariosConfig" class="submenu-link">⏰ Horarios</a></div>

                <div class="submenu-item"><a href="/Feriados/FeriadosConfig" class="submenu-link">📅 Feriados</a></div>
                <div class="submenu-item"><a href="/Bono/GestionBonos" class="submenu-link">🎁 Bonos</a></div>
            </div>
        </div>

        <div class="menu-item">
            <a href="/Bono/AsignarBono" class="menu-link"><div class="icon">💵 </div>Bonos</a>
        </div>

        <div class="menu-item">
            <a href="/AdminGestionUsuarios/GestionUsuarios" class="menu-link">
                <div class="icon">📝</div>
                Gestion de Empleados
            </a>
        </div>

        <div class="menu-item">
            <a href="/Admin/RankingPuntualidad" class="menu-link active"><div class="icon">⏱️</div>Indicadores de Puntualidad</a>
        </div>

        <div class="menu-item">
            <a href="/Admin/Reportes" class="menu-link"><div class="icon">📄</div>Reportes</a>
        </div>
    </div>

    <!-- Content -->
    <div class="content">
        <div class="content-header">
            <div>
                <h1>🏅 Ranking de Puntualidad</h1>
                <p>Comparativa de asistencia y puntualidad de los colaboradores</p>
            </div>
            <div class="period-selector">
                <label>Período:</label>
                <select id="periodoSelect" onchange="cargarRanking()">
                    <!-- Se llena con JS -->
                </select>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">👥</div>
                <div class="stat-value" id="statEmpleados">—</div>
                <div class="stat-label">Colaboradores</div>
            </div>
            <div class="stat-card green">
                <div class="stat-icon">✅</div>
                <div class="stat-value" id="statPromedio">—</div>
                <div class="stat-label">Puntualidad promedio</div>
            </div>
            <div class="stat-card green">
                <div class="stat-icon">🥇</div>
                <div class="stat-value" id="statMejor">—</div>
                <div class="stat-label">Mejor colaborador</div>
            </div>
            <div class="stat-card red">
                <div class="stat-icon">⚠️</div>
                <div class="stat-value" id="statTardanzas">—</div>
                <div class="stat-label">Total tardanzas</div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="table-section">
            <div class="section-header">
                <h2>📋 Detalle por colaborador</h2>
                <input type="text"
                       class="search-box"
                       id="searchBox"
                       placeholder="🔍 Buscar colaborador..."
                       oninput="filtrarTabla()" />
            </div>
            <div class="table-wrapper">
                <table class="ranking-table" id="rankingTable">
                    <thead>
                        <tr>
                            <th onclick="sortBy('nombre')">Colaborador <span class="sort-icon">⇅</span></th>
                            <th onclick="sortBy('diasTrabajados')">Días trabajados <span class="sort-icon">⇅</span></th>
                            <th onclick="sortBy('diasPuntuales')">Días puntuales <span class="sort-icon">⇅</span></th>
                            <th onclick="sortBy('tardanzas')">Tardanzas <span class="sort-icon">⇅</span></th>
                            <th onclick="sortBy('horaPromedio')">Hora prom. entrada <span class="sort-icon">⇅</span></th>
                            <th onclick="sortBy('puntualidad')">% Puntualidad <span class="sort-icon">⇅</span></th>
                        </tr>
                    </thead>
                    <tbody id="rankingBody">
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <div class="empty-state-icon">⏳</div>
                                    <h3>Cargando datos...</h3>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    let todosLosDatos = [];
    let sortColumn    = 'puntualidad';
    let sortAsc       = false;

    // ── Generar opciones de quarters ────────────────────────────────
    function generarQuarters() {
        const sel  = document.getElementById('periodoSelect');
        const hoy  = new Date();
        const anio = hoy.getFullYear();
        const quarters = [];

        // Últimos 6 quarters (incluyendo el actual)
        for (let i = 0; i < 6; i++) {
            let q = Math.floor((hoy.getMonth()) / 3) - i;
            let y = anio;

            while (q < 0) { q += 4; y--; }

            const inicio = new Date(y, q * 3, 1);
            const fin    = new Date(y, q * 3 + 3, 0);

            const key    = `${inicio.toISOString().slice(0,10)}_${fin.toISOString().slice(0,10)}`;
            const label  = `Q${q + 1} ${y} (${fmtMes(inicio)} - ${fmtMes(fin)})`;

            quarters.push({ key, label });
        }

        quarters.forEach((qt, idx) => {
            const opt       = document.createElement('option');
            opt.value       = qt.key;
            opt.textContent = qt.label;
            if (idx === 0) opt.selected = true;
            sel.appendChild(opt);
        });
    }

    function fmtMes(d) {
        return d.toLocaleDateString('es-CR', { month: 'short', year: '2-digit' });
    }

    // ── Cargar ranking desde API ────────────────────────────────────
    async function cargarRanking() {
        const val    = document.getElementById('periodoSelect').value;
        const [desde, hasta] = val.split('_');

        document.getElementById('rankingBody').innerHTML = `
            <tr><td colspan="6">
                <div class="empty-state">
                    <div class="empty-state-icon">⏳</div>
                    <h3>Cargando...</h3>
                </div>
            </td></tr>`;

        try {
            const res  = await fetch(`/Admin/ObtenerRankingPuntualidad?desde=${desde}&hasta=${hasta}`);
            const data = await res.json();

            if (!data.success) { mostrarError(data.message); return; }

            todosLosDatos = data.ranking;
            actualizarStats(todosLosDatos);
            renderTabla(todosLosDatos);
        } catch (e) {
            mostrarError('Error al conectar con el servidor.');
        }
    }

    // ── Stats resumen ───────────────────────────────────────────────
    function actualizarStats(ranking) {
        const total = ranking.length;

        const promedio = total > 0
            ? (ranking.reduce((s, r) => s + r.puntualidad, 0) / total).toFixed(1)
            : 0;

        const mejor = total > 0
            ? ranking.reduce((a, b) => a.puntualidad > b.puntualidad ? a : b)
            : null;

        const tardanzas = ranking.reduce((s, r) => s + r.tardanzas, 0);

        document.getElementById('statEmpleados').textContent  = total;
        document.getElementById('statPromedio').textContent   = `${promedio}%`;
        document.getElementById('statMejor').textContent      = mejor ? mejor.nombre.split(' ')[0] : '—';
        document.getElementById('statTardanzas').textContent  = tardanzas;
    }

    // ── Render tabla ────────────────────────────────────────────────
    function renderTabla(datos) {
        const body = document.getElementById('rankingBody');

        if (!datos || datos.length === 0) {
            body.innerHTML = `
                <tr><td colspan="6">
                    <div class="empty-state">
                        <div class="empty-state-icon">📭</div>
                        <h3>Sin datos</h3>
                        <p>No hay marcas registradas en este período.</p>
                    </div>
                </td></tr>`;
            return;
        }

        // Ordenar
        const sorted = [...datos].sort((a, b) => {
            let va = a[sortColumn], vb = b[sortColumn];
            if (typeof va === 'string') va = va.toLowerCase();
            if (typeof vb === 'string') vb = vb.toLowerCase();
            if (va < vb) return sortAsc ? -1 : 1;
            if (va > vb) return sortAsc ?  1 : -1;
            return 0;
        });

        body.innerHTML = sorted.map(r => {
            const pct     = r.puntualidad.toFixed(1);
            const color   = pct >= 90 ? '#48bb78' : pct >= 70 ? '#f59e0b' : '#e53e3e';
            const badgeCls = pct >= 90 ? 'badge-success' : pct >= 70 ? 'badge-warning' : 'badge-danger';
            const iniciales = r.nombre.split(' ').slice(0,2).map(p => p[0]).join('').toUpperCase();

            return `
            <tr>
                <td>
                    <div class="empleado-cell">
                        <div class="avatar">${iniciales}</div>
                        <span class="empleado-name">${r.nombre}</span>
                    </div>
                </td>
                <td>${r.diasTrabajados}</td>
                <td>${r.diasPuntuales}</td>
                <td>
                    <span class="badge ${r.tardanzas === 0 ? 'badge-success' : r.tardanzas <= 3 ? 'badge-warning' : 'badge-danger'}">
                        ${r.tardanzas}
                    </span>
                </td>
                <td>
                    <span class="hora-chip">🕐 ${r.horaPromedioEntrada}</span>
                </td>
                <td>
                    <div class="progress-wrap">
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill"
                                 style="width:${pct}%; background:${color};"></div>
                        </div>
                        <span class="progress-label" style="color:${color};">${pct}%</span>
                    </div>
                </td>
            </tr>`;
        }).join('');

        // Actualizar íconos de sort
        document.querySelectorAll('.ranking-table th').forEach(th => th.classList.remove('sorted'));
    }

    // ── Ordenar al hacer click en header ───────────────────────────
    function sortBy(col) {
        if (sortColumn === col) sortAsc = !sortAsc;
        else { sortColumn = col; sortAsc = false; }

        const busqueda = document.getElementById('searchBox').value.toLowerCase();
        const filtrado = todosLosDatos.filter(r =>
            r.nombre.toLowerCase().includes(busqueda));

        renderTabla(filtrado);
    }

    // ── Filtro de búsqueda ──────────────────────────────────────────
    function filtrarTabla() {
        const q = document.getElementById('searchBox').value.toLowerCase();
        renderTabla(todosLosDatos.filter(r => r.nombre.toLowerCase().includes(q)));
    }

    // ── Error ───────────────────────────────────────────────────────
    function mostrarError(msg) {
        document.getElementById('rankingBody').innerHTML = `
            <tr><td colspan="6">
                <div class="empty-state">
                    <div class="empty-state-icon">⚠️</div>
                    <h3>Error</h3>
                    <p>${msg}</p>
                </div>
            </td></tr>`;
    }

    // ── Init ────────────────────────────────────────────────────────
    generarQuarters();
    cargarRanking();
</script>
