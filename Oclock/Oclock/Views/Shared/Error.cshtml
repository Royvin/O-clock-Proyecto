@model Oclock.Models.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<style>
    .error-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: #F5F7FA;
    }

    .error-card {
        width: 100%;
        max-width: 720px;
        background: #FFFFFF;
        border-radius: 18px;
        padding: 38px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.10);
        border: 1px solid #E0E0E0;
        text-align: center;
    }

    .error-icon {
        width: 86px;
        height: 86px;
        background: #FCE4E4;
        color: #D32F2F;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        margin: 0 auto 22px auto;
        border: 1px solid #FCE4E4;
    }

    .error-title {
        color: #263238;
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .error-description {
        color: #78909C;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .error-note {
        background: #F5F7FA;
        border: 1px solid #E0E0E0;
        color: #455A64;
        padding: 16px;
        border-radius: 12px;
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 24px;
        text-align: left;
    }

    .error-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .error-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 22px;
        background: #1565C0;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }

        .error-btn:hover {
            background: #0D47A1;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(21, 101, 192,0.30);
        }

    .error-btn-secondary {
        background: #E0E0E0;
        color: #263238;
    }

        .error-btn-secondary:hover {
            background: #E0E0E0;
            color: #263238;
            box-shadow: none;
        }

    .error-request {
        margin-top: 22px;
        color: #78909C;
        font-size: 12px;
        word-break: break-word;
    }

        .error-request code {
            background: #F5F7FA;
            color: #455A64;
            padding: 4px 8px;
            border-radius: 6px;
            border: 1px solid #E0E0E0;
        }

    @@media (max-width: 650px) {
        .error-card {
            padding: 28px 22px;
        }

        .error-title {
            font-size: 24px;
        }

        .error-actions {
            flex-direction: column;
        }

        .error-btn {
            width: 100%;
        }
    }

</style>

<div class="error-page">
    <div class="error-card">
        <div class="error-icon">
            ⚠️
        </div>

        <h1 class="error-title">Ocurrió un problema</h1>

        <p class="error-description">
            No se pudo procesar la solicitud en este momento. Puede volver a intentarlo o regresar a la pantalla anterior.
        </p>

        <div class="error-note">
            Si el problema continúa, comuníquelo al encargado del sistema indicando qué acción estaba realizando.
            Esto ayudará a revisar el caso más rápido.
        </div>

        <div class="error-actions">
            <button type="button" class="error-btn" onclick="volverAtras()">
                ⬅️ Volver
            </button>

            <a href="/Usuario/Index" class="error-btn error-btn-secondary">
                🔐 Ir al acceso
            </a>
        </div>

        @if (Model != null && Model.ShowRequestId)
        {
            <div class="error-request">
                Código de referencia:
                <code>@Model.RequestId</code>
            </div>
        }
    </div>
</div>

<script>
    function volverAtras() {
        if (window.history.length > 1) {
            window.history.back();
            return;
        }

        window.location.href = '/Usuario/Index';
    }
</script>